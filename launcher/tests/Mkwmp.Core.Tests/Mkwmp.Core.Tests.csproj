<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\Mkwmp.Core\Mkwmp.Core.csproj" />
    <!-- The update helper's own signature check and arguments (SelfUpdateTests); its swap is Mkwmp.Update's, through Core. -->
    <ProjectReference Include="..\..\src\Mkwmp.Updater\Mkwmp.Updater.csproj" />
    <!-- Copies of real game files the tests edit (mkw.ini from an mkw-recomp 0.1.15 install, paths made generic). -->
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The window's catalogs, for CatalogTests: every language has English's keys and placeholders. -->
    <None Include="..\..\src\Mkwmp.App\i18n\*.json" Link="i18n\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The window's pure input and palette math (no WPF in these files): ShellMathTests. -->
    <Compile Include="..\..\src\Mkwmp.App\Themes\Palette.cs" Link="App\Palette.cs" />
    <Compile Include="..\..\src\Mkwmp.App\Input\PadLayout.cs" Link="App\PadLayout.cs" />
    <Compile Include="..\..\src\Mkwmp.App\Input\ScrollMotion.cs" Link="App\ScrollMotion.cs" />
    <Compile Include="..\..\src\Mkwmp.App\Input\TapTracker.cs" Link="App\TapTracker.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- the palette files, read as plain XML by ShellMathTests -->
    <None Include="..\..\src\Mkwmp.App\Themes\Colors.*.xaml" Link="Themes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
