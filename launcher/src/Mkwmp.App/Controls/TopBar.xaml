<UserControl x:Class="Mkwmp.App.Controls.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             Height="188" Focusable="False">
  <!-- DataContext: ShellViewModel. Left: the player and the friends who are on (each opens the
       friends panel). Right: clock, network link, battery (hidden without one). -->
  <Grid Margin="62,34,72,0">
    <ItemsControl ItemsSource="{Binding TopAvatars}" Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Left"
                  input:FocusNav.IsGroup="True">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource AvatarButton}" Click="OnAvatar">
            <c:Avatar DisplayName="{Binding Name}" Presence="{Binding Presence}" Count="{Binding Count}" />
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <TextBlock Text="{Binding ClockText}" Style="{StaticResource Text.Base}" FontSize="40" FontWeight="SemiBold" />
      <!-- the machine's link (Wi-Fi bars / wired / offline), read on Windows and under Proton alike -->
      <c:NetworkIcon x:Name="Net" Margin="30,0,0,0" VerticalAlignment="Center" Kind="{Binding Network}" Bars="{Binding WifiBars}"
                     Foreground="{DynamicResource Brush.Text}" />
      <StackPanel Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center"
                  Visibility="{Binding HasBattery, Converter={StaticResource Conv.Visible}}">
        <TextBlock Style="{StaticResource Text.Base}" FontSize="40" FontWeight="SemiBold" Text="{Binding BatteryPercent}" />
        <TextBlock Style="{StaticResource Text.Base}" FontSize="26" FontWeight="SemiBold" Text="%" VerticalAlignment="Bottom" Margin="2,0,0,7" />
        <c:BatteryIcon Margin="18,2,0,0" VerticalAlignment="Center" Percent="{Binding BatteryPercent}" Charging="{Binding BatteryCharging}" PluggedIn="{Binding BatteryPluggedIn}"
                       Foreground="{DynamicResource Brush.Text}" Good="{DynamicResource Brush.Good}" Low="{DynamicResource Brush.Bad}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
