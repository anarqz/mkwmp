<Window x:Class="Mkwmp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Mkwmp.App.Controls"
        xmlns:v="clr-namespace:Mkwmp.App.Views"
        Title="MKWMP" Icon="pack://application:,,,/Assets/mkwmp.ico" Width="1280" Height="720" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{DynamicResource Font.Ui}" FontSize="{StaticResource Size.Body}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FocusVisualStyle="{x:Null}">
  <!-- DataContext: ShellViewModel.
       Root is the window in real pixels; Stage is the same area in stage units: always 1080 high
       (a 16:10 screen gets a narrower stage, 1728 wide, never bars). Everything is laid out in
       stage units and scaled by Stage's LayoutTransform. -->
  <Grid x:Name="Root" Background="{DynamicResource Brush.Background}">
    <Grid x:Name="Stage" Width="1920" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Grid.LayoutTransform>
        <ScaleTransform x:Name="StageScale" />
      </Grid.LayoutTransform>

      <!-- 0: the page (with the top bar on home) -->
      <Grid x:Name="BaseLayer">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="112" />
        </Grid.RowDefinitions>
        <c:TopBar x:Name="TopChrome" Visibility="{Binding ShowTopBar, Converter={StaticResource Conv.Visible}}" />
        <c:PageHost x:Name="Pages" Grid.Row="1" Navigator="{Binding Nav}" />
      </Grid>

      <!-- the game's download or setup, while it runs: a spinner, what it is and how far; a click opens its card
           (ShellViewModel.GameWork.cs). Not a stop of the controller's focus: the Game tile, PLAY and Settings › Game lead there. -->
      <Button x:Name="GameWorkPill" Style="{StaticResource ChromeButton}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0"
              Padding="22,10" Focusable="False" Command="{Binding GameWorkCommand}"
              Visibility="{Binding ShowGameWorkIndicator, Converter={StaticResource Conv.Visible}}">
        <StackPanel Orientation="Horizontal">
          <c:Spinner Width="30" Height="30" Margin="0,0,14,0" />
          <TextBlock Text="{Binding GameWorkTitle}" Style="{StaticResource Text.Base}" FontSize="24" MaxWidth="560" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding GameWorkPercent}" Style="{StaticResource Text.Base}" FontSize="24" FontWeight="SemiBold" Margin="14,0,0,0" />
        </StackPanel>
      </Button>

      <!-- the page's hint bar. A layer that covers it brings its own: the two side panels below (c:HintBar InPanel),
           the on-screen keyboard. While one of those panels is open this one keeps only its input picture, dimmed
           with the page: the buttons shown belong to the panel. -->
      <c:HintBar x:Name="Hints" ShowHints="{Binding IsSidePanelOpen, Converter={StaticResource Conv.Not}}" />

      <!-- 1: the friends panel, from the right, on any page: over the whole height, its own hint bar at its bottom -->
      <Border x:Name="FriendsScrim" Background="{DynamicResource Brush.Dim}" MouseLeftButtonUp="OnFriendsScrim"
              Visibility="{Binding IsFriendsOpen, Converter={StaticResource Conv.Visible}}" />
      <c:SlideHost x:Name="FriendsLayer" IsOpen="{Binding IsFriendsOpen}" Edge="Right" HorizontalAlignment="Right" Width="700">
        <Grid>
          <v:FriendsPanel DataContext="{Binding FriendsPanel}" />
          <c:HintBar InPanel="True" />
        </Grid>
      </c:SlideHost>

      <!-- 1b: a page's drawer (ShellViewModel.Drawer.cs), from the right over the dimmed page: one mod over the list of
           mods. Its hint bar is inside the panel, as the friends panel's. -->
      <Border x:Name="DrawerScrim" Background="{DynamicResource Brush.Dim}" MouseLeftButtonUp="OnDrawerScrim"
              Visibility="{Binding IsDrawerOpen, Converter={StaticResource Conv.Visible}}" />
      <c:SlideHost x:Name="DrawerLayer" IsOpen="{Binding IsDrawerOpen}" Edge="Right" HorizontalAlignment="Right" Width="1020">
        <Grid>
          <ContentControl Content="{Binding Drawer}" Focusable="False" />
          <c:HintBar InPanel="True" />
        </Grid>
      </c:SlideHost>

      <!-- 2: a bottom sheet -->
      <Border x:Name="SheetScrim" Background="{DynamicResource Brush.Dim}" MouseLeftButtonUp="OnSheetScrim"
              Visibility="{Binding IsSheetOpen, Converter={StaticResource Conv.Visible}}" />
      <c:BottomSheet x:Name="SheetLayer" IsOpen="{Binding IsSheetOpen}" Content="{Binding Sheet}" />

      <!-- 3: the modal, over everything but the toasts -->
      <c:ModalHost x:Name="ModalLayer" />

      <!-- 3b: the launcher's own file and folder picker (ShellViewModel.Picker.cs), from the right, above a modal (the
           game setup's card opens it) and under the on-screen keyboard (its path box uses it). Its hint bar is inside
           the panel, as the friends panel's. -->
      <Grid x:Name="PickerLayer">
        <Border Background="{DynamicResource Brush.Dim}" MouseLeftButtonUp="OnPickerScrim"
                Visibility="{Binding IsPickerOpen, Converter={StaticResource Conv.Visible}}" />
        <c:SlideHost IsOpen="{Binding IsPickerOpen}" Edge="Right" HorizontalAlignment="Right" Width="1180">
          <Grid>
            <v:PickerSidebar DataContext="{Binding Picker}" />
            <c:HintBar InPanel="True" />
          </Grid>
        </c:SlideHost>
      </Grid>

      <!-- 4: the on-screen keyboard (Input/TextEntry opens it for any text box) -->
      <c:OnScreenKeyboard x:Name="KeyboardLayer" />
      <c:ToastHost />

      <!-- 5: the overlay animation (MainWindow.Overlay.cs): the game's picture, from the whole stage into home's
           Play tile and back. Only the clip and the two transforms change per frame: no layout. While it is
           visible it also takes the pointer, so nothing under it is clicked mid-flight. -->
      <Canvas x:Name="OverlayFx" Visibility="Collapsed" Background="Transparent" UseLayoutRounding="False" SnapsToDevicePixels="False">
        <Canvas x:Name="FxCard">
          <Canvas.Clip>
            <RectangleGeometry x:Name="FxClip" />
          </Canvas.Clip>
          <Image x:Name="FxImage" Stretch="Fill" Width="1000" Height="562.5">
            <Image.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="FxScale" />
                <TranslateTransform x:Name="FxShift" />
              </TransformGroup>
            </Image.RenderTransform>
          </Image>
        </Canvas>
      </Canvas>
    </Grid>
  </Grid>
</Window>
