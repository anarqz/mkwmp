<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Nunito (OFL) is inside the exe: the same letters on Windows and under Wine/Proton.
       Sizes are in stage units: the stage is always 1080 units high (see MainWindow). -->
  <FontFamily x:Key="Font.Ui">pack://application:,,,/Assets/Fonts/#Nunito</FontFamily>

  <sys:Double x:Key="Size.Display">56</sys:Double>
  <sys:Double x:Key="Size.Title">42</sys:Double>
  <sys:Double x:Key="Size.Heading">34</sys:Double>
  <sys:Double x:Key="Size.Body">30</sys:Double>
  <sys:Double x:Key="Size.Caption">25</sys:Double>
  <sys:Double x:Key="Size.Small">21</sys:Double>

  <!-- Layout metrics shared by pages. -->
  <sys:Double x:Key="Metric.RowHeight">104</sys:Double>
  <sys:Double x:Key="Metric.HeaderHeight">126</sys:Double>
  <sys:Double x:Key="Metric.HintBarHeight">112</sys:Double>
  <Thickness x:Key="Metric.PageMargin">72,0,72,0</Thickness>
  <CornerRadius x:Key="Radius.Card">14</CornerRadius>
  <CornerRadius x:Key="Radius.Tile">20</CornerRadius>
  <sys:Double x:Key="Radius.Control">12</sys:Double>

  <Style x:Key="Text.Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Size.Display}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Size.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Size.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="42" />
  </Style>
  <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="36" />
  </Style>
  <Style x:Key="Text.Small" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Size.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>
  <Style x:Key="Text.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style x:Key="Text.Accent" TargetType="TextBlock" BasedOn="{StaticResource Text.Heading}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
</ResourceDictionary>
