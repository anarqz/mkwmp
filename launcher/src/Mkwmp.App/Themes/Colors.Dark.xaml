<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The dark palette: the same keys as Colors.Light.xaml. -->
  <SolidColorBrush x:Key="Brush.Background" Color="#FF2A2A2D" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FF3B3B40" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF333337" />
  <SolidColorBrush x:Key="Brush.Modal" Color="#FF37373B" />
  <SolidColorBrush x:Key="Brush.Text" Color="#FFF3F3F3" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#FFB1B1B6" />
  <SolidColorBrush x:Key="Brush.TextFaint" Color="#FF737378" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#FF5CB8FF" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2E5CB8FF" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF0F1A26" />
  <SolidColorBrush x:Key="Brush.Rule" Color="#FF56565C" />
  <SolidColorBrush x:Key="Brush.Bar" Color="#FFF3F3F3" />
  <SolidColorBrush x:Key="Brush.Good" Color="#FF3DD27A" />
  <SolidColorBrush x:Key="Brush.Warn" Color="#FFFFB933" />
  <SolidColorBrush x:Key="Brush.Bad" Color="#FFFF6B61" />
  <SolidColorBrush x:Key="Brush.Dim" Color="#99000000" />
  <SolidColorBrush x:Key="Brush.Focus.Fill" Color="#FF47474D" />
  <SolidColorBrush x:Key="Brush.Track" Color="#FF5C5C62" />
  <SolidColorBrush x:Key="Brush.Knob" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Hover" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="Brush.Glyph" Color="#FFF3F3F3" />
  <SolidColorBrush x:Key="Brush.OnGlyph" Color="#FF2A2A2D" />
  <SolidColorBrush x:Key="Brush.Toast" Color="#FF47474D" />
  <SolidColorBrush x:Key="Brush.Outline" Color="#FF8E8E94" />
</ResourceDictionary>
