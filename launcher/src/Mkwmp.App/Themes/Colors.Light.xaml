<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The light palette. Colors.Dark.xaml has the same keys; ThemeManager swaps one for the other
       at runtime, so every use of these must be a DynamicResource. See docs/DESIGN.md. -->
  <SolidColorBrush x:Key="Brush.Background" Color="#FFEBEBEB" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FFF6F6F6" />
  <SolidColorBrush x:Key="Brush.Modal" Color="#FFF0F0F0" />
  <SolidColorBrush x:Key="Brush.Text" Color="#FF2B2B2B" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF6C6C6C" />
  <SolidColorBrush x:Key="Brush.TextFaint" Color="#FFAEAEAE" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#FF1E64E6" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1F1E64E6" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Rule" Color="#FFC6C6C6" />
  <SolidColorBrush x:Key="Brush.Bar" Color="#FF2B2B2B" />
  <SolidColorBrush x:Key="Brush.Good" Color="#FF16A34A" />
  <SolidColorBrush x:Key="Brush.Warn" Color="#FFD98200" />
  <SolidColorBrush x:Key="Brush.Bad" Color="#FFE0352B" />
  <SolidColorBrush x:Key="Brush.Dim" Color="#73000000" />
  <SolidColorBrush x:Key="Brush.Focus.Fill" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Track" Color="#FFCFCFCF" />
  <SolidColorBrush x:Key="Brush.Knob" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Hover" Color="#0D000000" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="#1A000000" />
  <SolidColorBrush x:Key="Brush.Glyph" Color="#FF2B2B2B" />
  <SolidColorBrush x:Key="Brush.OnGlyph" Color="#FFEBEBEB" />
  <SolidColorBrush x:Key="Brush.Toast" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Outline" Color="#FF8A8A8A" />
</ResourceDictionary>
