<Application x:Class="Mkwmp.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <!-- The design system (docs/DESIGN.md). No Fluent theme, no system fonts, no icon fonts: every
           colour, letter and icon the shell draws comes from these files, so the launcher looks the
           same on Windows and under Wine/Proton on the Steam Deck.
           The FIRST dictionary is the palette: ThemeManager swaps it (light / dark) at runtime. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Colors.Light.xaml" />
        <ResourceDictionary Source="Themes/Typography.xaml" />
        <ResourceDictionary Source="Themes/Icons.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
        <ResourceDictionary Source="Views/ViewMap.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
