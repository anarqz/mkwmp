<UserControl x:Class="Mkwmp.App.Views.OnlineLocked"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             x:Name="Self" Focusable="False">
  <!-- The locked state of anything that needs a server (docs/DESIGN.md, section 12): a picture, what
       lives there, one line, and the "Configure online" button. The same in the friends panel and in
       a settings pane. DataContext: anything with S and ConfigureOnlineCommand. -->
  <StackPanel HorizontalAlignment="Center" MaxWidth="760">
    <!-- online is off: the offline picture (Assets/Art) -->
    <Image Source="pack://application:,,,/Assets/Art/empty-offline.png" Height="210" HorizontalAlignment="Center"
           RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
    <TextBlock Text="{Binding Title, ElementName=Self}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap" TextAlignment="Center"
               HorizontalAlignment="Center" Margin="0,30,0,0" />
    <TextBlock Text="{Binding Text, ElementName=Self}" Style="{StaticResource Text.Caption}" FontSize="26" LineHeight="38" TextAlignment="Center"
               HorizontalAlignment="Center" Margin="0,12,0,0" />
    <c:ConsoleButton Kind="Primary" Icon="{StaticResource Icon.Globe}" Content="{Binding S[online.configure]}" HorizontalAlignment="Center"
                     MinWidth="360" Margin="0,34,0,0" Command="{Binding ConfigureOnlineCommand}" />
  </StackPanel>
</UserControl>
