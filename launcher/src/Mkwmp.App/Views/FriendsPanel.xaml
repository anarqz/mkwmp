<UserControl x:Class="Mkwmp.App.Views.FriendsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             xmlns:vm="clr-namespace:Mkwmp.App.ViewModels"
             xmlns:v="clr-namespace:Mkwmp.App.Views"
             Focusable="False">
  <!-- DataContext: FriendsPanelViewModel. Header, "add a friend", one message line, then the list in
       sections (requests, friends, sent). The shell slides it in from the right and dims the page; the
       bottom 112 units belong to the panel's own hint bar (MainWindow.xaml). Without a server (Locked) only the header and the locked
       state: no field, no list. On Nextendo Network (OnNextendo: a linked account, PLAY goes there) the same panel
       holds that account's Nextendo friends: its own friend code with Copy above the field, which takes a friend code,
       and after the requests and the friends the requests sent and the players met in a race. -->
  <UserControl.Resources>
    <!-- a small button inside a line of the list -->
    <Style x:Key="RowButton" TargetType="c:ConsoleButton" BasedOn="{StaticResource {x:Type c:ConsoleButton}}">
      <Setter Property="Height" Value="64" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="24,0" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate DataType="{x:Type vm:FriendsSection}">
      <c:SectionHeader Text="{Binding Text}" Margin="6,22,6,6" FontSize="24" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FriendRequestRow}">
      <Grid Margin="16,8,6,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <c:Avatar DisplayName="{Binding Name}" Width="72" Height="72" Color="{Binding Color}" Picture="{Binding Picture}" />
        <StackPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontSize="30" />
          <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" FontSize="22" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" input:FocusNav.IsGroup="True">
          <c:ConsoleButton Style="{StaticResource RowButton}" Kind="Primary" Command="{Binding AcceptCommand}"
                           Content="{Binding DataContext.S[friends.accept], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           input:FocusNav.IsDefault="{Binding IsDefault}" />
          <c:ConsoleButton Style="{StaticResource RowButton}" Kind="Secondary" Margin="10,0,0,0" Command="{Binding DeclineCommand}"
                           Content="{Binding DataContext.S[friends.decline], RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FriendRow}">
      <Button Style="{StaticResource CardButton}" Background="Transparent" Padding="16,10" Margin="0,2" Command="{Binding OpenCommand}"
              input:FocusNav.IsDefault="{Binding IsDefault}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:Avatar DisplayName="{Binding Name}" Presence="{Binding Presence}" Width="72" Height="72" Color="{Binding Color}" Picture="{Binding Picture}" />
          <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Base}" FontSize="30" Margin="20,0,12,0" VerticalAlignment="Center" />
          <TextBlock x:Name="State" Grid.Column="2" Text="{Binding StateText}" Style="{StaticResource Text.Base}" FontSize="24" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center" Margin="0,0,6,0" />
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Playing">
          <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Online">
          <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Brush.Good}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- a friend on Nextendo: the name (a star when a favourite), what they do under it, their friend code at the right -->
    <DataTemplate DataType="{x:Type vm:NextendoFriendRow}">
      <Button Style="{StaticResource CardButton}" Background="Transparent" Padding="16,10" Margin="0,2" Command="{Binding OpenCommand}"
              input:FocusNav.IsDefault="{Binding IsDefault}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:Avatar DisplayName="{Binding Name}" Presence="{Binding Presence}" Width="72" Height="72" Color="{Binding Color}" Picture="{Binding Picture}" />
          <StackPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
            <DockPanel LastChildFill="False">
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontSize="30" TextTrimming="CharacterEllipsis" MaxWidth="290" />
              <c:Icon Data="{StaticResource Icon.Star}" Width="24" Height="24" Margin="10,2,0,0" StrokeThickness="2.2" VerticalAlignment="Center"
                      Foreground="{DynamicResource Brush.Warn}" Visibility="{Binding Favorite, Converter={StaticResource Conv.Visible}}" />
            </DockPanel>
            <TextBlock x:Name="State" Text="{Binding StateText}" Style="{StaticResource Text.Base}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextFaint}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding FriendCode}" Style="{StaticResource Text.Small}" FontSize="19" VerticalAlignment="Center" Margin="0,0,6,0"
                     Foreground="{DynamicResource Brush.TextFaint}" />
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Playing">
          <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Online">
          <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Brush.Good}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- someone on Nextendo who is not a friend: asked (no button), or met in a race (Add) -->
    <DataTemplate DataType="{x:Type vm:NextendoPersonRow}">
      <Grid Margin="16,8,6,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <c:Avatar DisplayName="{Binding Name}" Width="72" Height="72" Opacity="0.7" Color="{Binding Color}" Picture="{Binding Picture}" />
        <StackPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontSize="30" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" FontSize="22" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <c:ConsoleButton Grid.Column="2" Style="{StaticResource RowButton}" Kind="Secondary" Command="{Binding ActCommand}" Content="{Binding ActionLabel}"
                         input:FocusNav.IsDefault="{Binding IsDefault}"
                         Visibility="{Binding HasAction, Converter={StaticResource Conv.Visible}}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FriendSentRow}">
      <Grid Margin="16,8,6,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <c:Avatar DisplayName="{Binding Name}" Width="72" Height="72" Opacity="0.7" Color="{Binding Color}" Picture="{Binding Picture}" />
        <StackPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontSize="30" />
          <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" FontSize="22" />
        </StackPanel>
        <c:ConsoleButton Grid.Column="2" Style="{StaticResource RowButton}" Kind="Secondary" Command="{Binding CancelCommand}"
                         Content="{Binding DataContext.S[friends.cancel], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         input:FocusNav.IsDefault="{Binding IsDefault}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Border Background="{DynamicResource Brush.Background}" CornerRadius="30,0,0,30">
    <Grid Margin="0,0,0,112">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Height="{StaticResource Metric.HeaderHeight}" Margin="44,0,44,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,10,0,0">
          <c:Icon Data="{StaticResource Icon.Friends}" Width="48" Height="48" StrokeThickness="1.8" Foreground="{DynamicResource Brush.Text}" />
          <TextBlock Text="{Binding S[friends.title]}" Style="{StaticResource Text.Title}" FontWeight="Regular" Margin="18,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,14,8,0" />
        <Border Height="1.5" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Rule}" />
      </Grid>

      <!-- add a friend by gamertag, and the one message line -->
      <StackPanel Grid.Row="1" Margin="56,26,56,0" Visibility="{Binding Unlocked, Converter={StaticResource Conv.Visible}}">
        <!-- on Nextendo: the player's own friend code, to give to a friend -->
        <Grid Margin="6,0,0,18" Visibility="{Binding ShowMyCode, Converter={StaticResource Conv.Visible}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding S[friends.nx.my_code]}" Style="{StaticResource Text.Small}" FontSize="21" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding MyCode}" Style="{StaticResource Text.Base}" FontSize="30" FontWeight="SemiBold" />
          </StackPanel>
          <c:ConsoleButton Grid.Column="1" Style="{StaticResource RowButton}" Kind="Secondary" Content="{Binding S[friends.nx.copy]}"
                           Command="{Binding CopyCodeCommand}" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <!-- the icon leads the box and stays (as a search field's); the text and its placeholder start after it -->
          <TextBox x:Name="EntryBox" Text="{Binding Entry, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding EntryMax}" IsEnabled="{Binding SignedIn}"
                   Padding="72,0,22,0" FontSize="27" input:TextEntry.Placeholder="{Binding AddHint}"
                   input:TextEntry.Title="{Binding AddTitle}" input:TextEntry.Charset="{Binding EntryCharset}"
                   input:TextEntry.Submitted="OnSubmitted" />
          <c:Icon Data="{StaticResource Icon.UserPlus}" Width="34" Height="34" Margin="24,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
          <c:ConsoleButton Grid.Column="1" Kind="Primary" Content="{Binding S[friends.add]}" MinWidth="140" Padding="26,0" Margin="14,0,0,0"
                           Command="{Binding AddCommand}" IsEnabled="{Binding SignedIn}" />
        </Grid>
        <!-- who is in the game's online lobby right now (nothing is stored): the page opens and the panel closes -->
        <c:ConsoleButton Style="{StaticResource RowButton}" Kind="Ghost" Icon="{StaticResource Icon.Friends}" Content="{Binding S[lobby.title]}"
                         Command="{Binding LobbyCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
        <TextBlock Text="{Binding NoteText}" FontSize="23" Margin="6,14,6,0" MinHeight="62">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding NoteTone}" Value="bad">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NoteTone}" Value="good">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Good}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>

      <!-- loading / nobody yet -->
      <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="56,0,56,60"
                  Visibility="{Binding IsLoading, Converter={StaticResource Conv.Visible}}">
        <c:Spinner Width="56" Height="56" />
      </StackPanel>
      <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="70,0,70,60"
                  Visibility="{Binding IsEmpty, Converter={StaticResource Conv.Visible}}">
        <Image Source="pack://application:,,,/Assets/Art/empty-friends.png" Width="460" HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Caption}" TextAlignment="Center" Margin="0,18,0,0" />
      </StackPanel>

      <c:SmoothScrollViewer Grid.Row="2" Padding="44,0,44,18" Visibility="{Binding Unlocked, Converter={StaticResource Conv.Visible}}">
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" input:FocusNav.IsGroup="True" />
      </c:SmoothScrollViewer>

      <!-- locked online: friends live on a server, and none is set -->
      <v:OnlineLocked Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Center" Margin="64,0,64,70"
                      Title="{Binding S[friends.locked.title]}" Text="{Binding S[friends.locked.text]}"
                      NextendoTitle="{Binding S[friends.nx.locked.title]}" NextendoText="{Binding S[friends.nx.locked.text]}"
                      Visibility="{Binding Locked, Converter={StaticResource Conv.Visible}}" />
    </Grid>
  </Border>
</UserControl>
