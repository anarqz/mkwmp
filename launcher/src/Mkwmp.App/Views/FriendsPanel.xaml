<UserControl x:Class="Mkwmp.App.Views.FriendsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             Focusable="False">
  <!-- DataContext: FriendsPanelViewModel. STUB: the panel's surface, header and a list of people.
       The shell slides it in from the right and dims the page; the bottom 112 units belong to the hint bar. -->
  <Border Background="{DynamicResource Brush.Background}" CornerRadius="30,0,0,30">
    <Grid Margin="0,0,0,112">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Height="{StaticResource Metric.HeaderHeight}" Margin="44,0,44,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,10,0,0">
          <c:Icon Data="{StaticResource Icon.Friends}" Width="48" Height="48" StrokeThickness="1.8" Foreground="{DynamicResource Brush.Text}" />
          <TextBlock Text="{Binding S[friends.title]}" Style="{StaticResource Text.Title}" FontWeight="Regular" Margin="18,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" Margin="0,14,8,0" />
        <Border Height="1.5" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Rule}" />
      </Grid>

      <c:SmoothScrollViewer Grid.Row="1" Padding="44,18,44,18">
        <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource CardButton}" Background="Transparent" Padding="16,14" Margin="0,2">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <c:Avatar DisplayName="{Binding Name}" Presence="{Binding Presence}" Width="76" Height="76" />
                  <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontSize="32" />
                    <TextBlock Text="{Binding State}" Style="{StaticResource Text.Small}" FontSize="24" />
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center"
                          Visibility="{Binding IsRequest, Converter={StaticResource Conv.Visible}}">
                    <TextBlock Text="{Binding DataContext.S[friends.request], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               Style="{StaticResource Text.Value}" FontSize="24" FontWeight="SemiBold" />
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </c:SmoothScrollViewer>
    </Grid>
  </Border>
</UserControl>
