<UserControl x:Class="Mkwmp.App.Views.PickerSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             Focusable="False">
  <!-- DataContext: PickerViewModel. The launcher's own file and folder picker (never the system's dialog): the header,
       the path (Up, its steps, and a box to type or paste one), the quick places at the left, the open folder's list,
       and under it what is asked for or why a choice was refused, with "Use This Folder". The shell slides it in from
       the right and dims the page; the bottom 112 units belong to the panel's own hint bar (MainWindow.xaml). -->
  <UserControl.Resources>
    <!-- a small button of the path row -->
    <Style x:Key="PathButton" TargetType="c:ConsoleButton" BasedOn="{StaticResource {x:Type c:ConsoleButton}}">
      <Setter Property="Height" Value="68" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="24,0" />
      <Setter Property="FontSize" Value="25" />
    </Style>

    <!-- a quick place: icon, label, a second line (free space, where it is); a bar while the open folder is in it -->
    <DataTemplate x:Key="PlaceTemplate">
      <Button Style="{StaticResource CardButton}" Background="Transparent" Padding="14,0" Margin="0,2" Height="70" Command="{Binding OpenCommand}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border x:Name="Bar" Width="5" Height="38" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-8,0,0,0"
                  Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
          <c:Icon x:Name="Ic" Data="{Binding Icon, Converter={StaticResource Conv.Icon}}" Width="32" Height="32" StrokeThickness="1.9" Margin="8,0,0,0"
                  Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="Label" Text="{Binding Label}" Style="{StaticResource Text.Base}" FontSize="24" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" FontSize="19" TextTrimming="CharacterEllipsis" Margin="0,-2,0,0"
                       Visibility="{Binding Detail, Converter={StaticResource Conv.Visible}}" />
          </StackPanel>
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
          <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
          <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
          <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
          <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- a line of the list: icon, name, the mark of a folder that holds what is looked for, modified, size -->
    <Style x:Key="EntryLine" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Height="68" Margin="12,2" Background="Transparent">
              <Border x:Name="Hover" CornerRadius="12" Background="{DynamicResource Brush.Hover}" Visibility="Collapsed" />
              <c:FocusRing IsActive="{TemplateBinding IsFocused}" CornerRadius="12" Fill="{DynamicResource Brush.Focus.Fill}" />
              <Grid x:Name="Line" Margin="18,0,20,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="144" />
                  <ColumnDefinition Width="108" />
                </Grid.ColumnDefinitions>
                <c:Icon x:Name="Ic" Data="{Binding Icon, Converter={StaticResource Conv.Icon}}" Width="34" Height="34" StrokeThickness="1.9"
                        Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Base}" FontSize="26" Margin="18,0,12,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Style="{StaticResource Pill}" Height="38" Padding="16,0" CornerRadius="19" VerticalAlignment="Center" Margin="0,0,4,0"
                        Visibility="{Binding Badge, Converter={StaticResource Conv.Visible}}">
                  <TextBlock Text="{Binding Badge}" Style="{StaticResource Text.Base}" FontSize="20" FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding Modified}" Style="{StaticResource Text.Small}" FontSize="21" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding Size}" Style="{StaticResource Text.Small}" FontSize="21" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource Text.Small}" FontSize="21" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Visibility="{Binding Detail, Converter={StaticResource Conv.Visible}}" />
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Accent}" Value="True">
                <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Dimmed}" Value="True">
                <Setter TargetName="Line" Property="Opacity" Value="0.42" />
              </DataTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsFocused" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the list itself: only the lines on screen exist (a folder of thousands of files) -->
    <Style TargetType="c:EntryList">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource EntryLine}" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="c:EntryList">
            <!-- the launcher's own viewer (a finger drags it, under Wine too, where touch is the mouse), scrolling the
                 virtualizing panel itself: its template is the default one with CanContentScroll on -->
            <c:SmoothScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
              <c:SmoothScrollViewer.Template>
                <ControlTemplate TargetType="c:SmoothScrollViewer">
                  <Grid Background="Transparent">
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="True" />
                    <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Margin="0,12,0,12"
                               Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                               Value="{TemplateBinding VerticalOffset}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                  </Grid>
                </ControlTemplate>
              </c:SmoothScrollViewer.Template>
              <ItemsPresenter />
            </c:SmoothScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource Brush.Background}" CornerRadius="30,0,0,30">
    <Grid Margin="0,0,0,112">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- header: what is being chosen; the X is for the mouse and touch (B closes) -->
      <Grid Height="{StaticResource Metric.HeaderHeight}" Margin="44,0,44,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <c:Icon Data="{Binding Icon, Converter={StaticResource Conv.Icon}}" Width="48" Height="48" StrokeThickness="1.8" Margin="8,10,0,0"
                Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="38" FontWeight="Regular" Margin="18,10,12,0"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Padding="14" Margin="0,10,-6,0" VerticalAlignment="Center" Command="{Binding CloseCommand}"
                AutomationProperties.Name="{Binding S[common.close]}">
          <c:Icon Data="{StaticResource Icon.Close}" Width="34" Height="34" StrokeThickness="2" Foreground="{DynamicResource Brush.TextMuted}" />
        </Button>
        <Border Grid.ColumnSpan="3" Height="1.5" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Rule}" />
      </Grid>

      <!-- the path: Up, a box to type or paste one (the on-screen keyboard opens on it), Go; under it the path's steps -->
      <StackPanel Grid.Row="1" Margin="56,22,56,0">
        <Grid input:FocusNav.IsGroup="True">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:ConsoleButton x:Name="UpButton" Style="{StaticResource PathButton}" Kind="Secondary" Icon="{StaticResource Icon.ArrowUp}"
                           Content="{Binding S[picker.up]}" Command="{Binding UpCommand}" />
          <TextBox x:Name="PathBox" Grid.Column="1" Height="68" FontSize="25" Padding="22,0" Margin="14,0,14,0"
                   Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}"
                   input:TextEntry.Title="{Binding S[picker.path_title]}" input:TextEntry.Submitted="OnPathSubmitted" />
          <TextBlock Grid.Column="1" Text="{Binding S[picker.path_hint]}" Style="{StaticResource Text.Base}" FontSize="25" Margin="38,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.TextFaint}" IsHitTestVisible="False"
                     Visibility="{Binding Text, ElementName=PathBox, Converter={StaticResource Conv.Visible}, ConverterParameter=!}" />
          <c:ConsoleButton Grid.Column="2" Style="{StaticResource PathButton}" Kind="Secondary" Content="{Binding S[picker.go]}" Command="{Binding GoCommand}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Crumbs}" Focusable="False" Margin="0,12,0,0" Height="46">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ChromeButton}" Padding="12,6" Command="{Binding OpenCommand}">
                  <TextBlock x:Name="Step" Text="{Binding Label}" Style="{StaticResource Text.Base}" FontSize="23" MaxWidth="250"
                             Foreground="{DynamicResource Brush.TextMuted}" />
                </Button>
                <c:Icon x:Name="Next" Data="{StaticResource Icon.ChevronRight}" Width="20" Height="20" StrokeThickness="2.2" Margin="2,2,2,0"
                        Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center" />
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                  <Setter TargetName="Next" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="Step" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                  <Setter TargetName="Step" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- the places at the left, the open folder at the right -->
      <Grid Grid.Row="2" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="380" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="1.5" HorizontalAlignment="Right" Margin="0,10,0,10" Background="{DynamicResource Brush.Rule}" />
        <DockPanel input:FocusNav.IsColumn="True">
          <TextBlock DockPanel.Dock="Top" Text="{Binding S[picker.places]}" Style="{StaticResource Text.Small}" FontSize="21" FontWeight="SemiBold" Margin="62,6,20,6" />
          <c:SmoothScrollViewer VerticalScrollBarVisibility="Hidden" Padding="44,2,18,12">
            <ItemsControl x:Name="PlacesList" ItemsSource="{Binding Places}" ItemTemplate="{StaticResource PlaceTemplate}" Focusable="False"
                          input:FocusNav.IsGroup="True" />
          </c:SmoothScrollViewer>
        </DockPanel>

        <Grid Grid.Column="1" Margin="6,0,32,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="30,6,32,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="144" />
              <ColumnDefinition Width="108" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding S[picker.col.name]}" Style="{StaticResource Text.Small}" FontSize="21" FontWeight="SemiBold" Margin="52,0,0,0" />
            <TextBlock Grid.Column="1" Text="{Binding S[picker.col.modified]}" Style="{StaticResource Text.Small}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Text="{Binding S[picker.col.size]}" Style="{StaticResource Text.Small}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Right" />
          </Grid>
          <c:EntryList x:Name="List" Grid.Row="1" ItemsSource="{Binding Entries}" Activated="OnActivated" />

          <!-- an empty folder, nothing that matches, a folder that cannot be opened -->
          <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="60,0,60,40" IsHitTestVisible="False"
                      Visibility="{Binding EmptyText, Converter={StaticResource Conv.Visible}}">
            <c:Icon Data="{Binding EmptyIcon, Converter={StaticResource Conv.Icon}}" Width="84" Height="84" StrokeThickness="1.4"
                    Foreground="{DynamicResource Brush.TextFaint}" />
            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Caption}" TextAlignment="Center" Margin="0,16,0,0" />
          </StackPanel>
          <c:Spinner Grid.Row="1" Width="56" Height="56" Margin="0,0,0,40" VerticalAlignment="Center" HorizontalAlignment="Center"
                     Visibility="{Binding IsLoading, Converter={StaticResource Conv.Visible}}" />
        </Grid>
      </Grid>

      <!-- what is asked for, or that this folder is a right one, or why a choice was refused; and the open folder as the pick -->
      <Grid Grid.Row="3" MinHeight="112" Margin="56,0,56,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Height="1.5" VerticalAlignment="Top" Background="{DynamicResource Brush.Rule}" />
        <Grid VerticalAlignment="Center" Margin="4,12,24,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <c:Spinner Width="30" Height="30" Margin="0,0,14,0" VerticalAlignment="Center" Visibility="{Binding Busy, Converter={StaticResource Conv.Visible}}" />
          <TextBlock Grid.Column="1" Text="{Binding Note}" FontSize="22" LineHeight="30" MaxHeight="92" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding NoteTone}" Value="bad">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding NoteTone}" Value="good">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Good}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <c:ConsoleButton x:Name="UseButton" Grid.Column="1" Height="76" MinWidth="0" Padding="34,0" FontSize="27" VerticalAlignment="Center"
                         Icon="{StaticResource Icon.Check}" Content="{Binding S[picker.use_folder]}" Command="{Binding UseFolderCommand}"
                         Visibility="{Binding ShowUseFolder, Converter={StaticResource Conv.Visible}}">
          <c:ConsoleButton.Style>
            <Style TargetType="c:ConsoleButton" BasedOn="{StaticResource {x:Type c:ConsoleButton}}">
              <Setter Property="Kind" Value="Secondary" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding FolderMatches}" Value="True">
                  <Setter Property="Kind" Value="Primary" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </c:ConsoleButton.Style>
        </c:ConsoleButton>
      </Grid>
    </Grid>
  </Border>
</UserControl>
