<UserControl x:Class="Mkwmp.App.Views.Mods.ModStorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             xmlns:mods="clr-namespace:Mkwmp.App.Views.Mods"
             Focusable="False">
  <!-- DataContext: ModPageViewModel. A GameBanana mod's page: its pictures, its files (each with Install), its description. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <c:PageHeader Title="{Binding Title}" Icon="{StaticResource Icon.Package}">
      <TextBlock Text="GameBanana" Style="{StaticResource Text.Small}" FontSize="23" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </c:PageHeader>
    <c:Spinner Grid.Row="1" Width="72" Height="72" Visibility="{Binding Loading, Converter={StaticResource Conv.Visible}}" />
    <c:SmoothScrollViewer Grid.Row="1" Padding="16,26,24,60" EdgePadding="110" input:FocusNav.IsGroup="True" HorizontalAlignment="Center" Width="1300"
                          Visibility="{Binding Loading, Converter={StaticResource Conv.Visible}, ConverterParameter=!}">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,26" Visibility="{Binding Error, Converter={StaticResource Conv.Visible}}">
          <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Bad}" />
        </Border>
        <StackPanel Visibility="{Binding Loaded, Converter={StaticResource Conv.Visible}}">
          <TextBlock Text="{Binding Byline}" Style="{StaticResource Text.Base}" FontSize="28" Foreground="{DynamicResource Brush.TextMuted}" Margin="20,0,20,0" />
          <TextBlock Text="{Binding License}" Style="{StaticResource Text.Caption}" Margin="20,8,20,0" Visibility="{Binding License, Converter={StaticResource Conv.Visible}}" />
          <TextBlock Text="{Binding Rated}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warn}" Margin="20,8,20,0"
                     Visibility="{Binding Rated, Converter={StaticResource Conv.Visible}}" />

          <ItemsControl ItemsSource="{Binding Shots}" Focusable="False" Margin="12,22,12,0" Visibility="{Binding HasShots, Converter={StaticResource Conv.Visible}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Height="190" Margin="8,0">
                  <Grid ClipToBounds="True">
                      <Border Background="{Binding Seed, Converter={StaticResource Conv.Art}}" CornerRadius="10" />
                      <c:Icon Data="{StaticResource Icon.Package}" Width="64" Height="64" Foreground="#CCFFFFFF" StrokeThickness="1.8"
                              Visibility="{Binding HasImage, Converter={StaticResource Conv.Visible}, ConverterParameter=!}" />
                      <Border CornerRadius="10" Visibility="{Binding HasImage, Converter={StaticResource Conv.Visible}}">
                        <Border.Background>
                          <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                      </Border>
                    </Grid>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding BlurNote}" Style="{StaticResource Text.Caption}" Margin="20,12,20,0" Visibility="{Binding BlurNote, Converter={StaticResource Conv.Visible}}" />

          <c:SectionHeader Text="{Binding S[mods.page.files]}" Margin="0,34,0,0" />
          <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <c:SettingsRow Label="{Binding Name}" Caption="{Binding Caption}" Icon="{StaticResource Icon.Download}" Kind="Chevron"
                               Value="{Binding DataContext.S[mods.install.yes], RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding InstallCommand}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <c:SettingsRow Label="{Binding S[mods.page.open]}" Icon="{StaticResource Icon.Globe}" Kind="Chevron" Command="{Binding OpenCommand}" />

          <c:SectionHeader Text="{Binding S[mods.page.description]}" Margin="0,34,0,0" Visibility="{Binding Description, Converter={StaticResource Conv.Visible}}" />
          <Button Style="{StaticResource CardButton}" Margin="0,14,0,0" Background="{DynamicResource Brush.SurfaceAlt}" Visibility="{Binding Description, Converter={StaticResource Conv.Visible}}">
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text}" />
          </Button>
        </StackPanel>
      </StackPanel>
    </c:SmoothScrollViewer>
  </Grid>
</UserControl>