<UserControl x:Class="Mkwmp.App.Views.Mods.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             xmlns:mods="clr-namespace:Mkwmp.App.Views.Mods"
             x:Name="Self" Focusable="False">
  <!-- DataContext: ModsViewModel. One line of the three ways to get a mod, "Installed" with its filter chips, then the mods in
       the game, one compact line each (A opens its drawer, X or its switch turns it on and off, Y turns them all off and back on). -->
  <UserControl.Resources>
    <!-- the first line: Get Mods, From Link, From Zip -->
    <Style x:Key="GetLine" TargetType="c:ConsoleButton" BasedOn="{StaticResource {x:Type c:ConsoleButton}}">
      <Setter Property="Height" Value="76" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="30,0" />
      <Setter Property="FontSize" Value="26" />
    </Style>
    <!-- a small button on a mod's line -->
    <Style x:Key="RowAction" TargetType="c:ConsoleButton" BasedOn="{StaticResource {x:Type c:ConsoleButton}}">
      <Setter Property="Height" Value="56" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="22,0" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="Margin" Value="14,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A mod's line: icon, name with version and author small beside it, chips, size. The switch is its own focus stop beside it. -->
    <Style x:Key="ModLine" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent" Height="84">
              <Border x:Name="Hover" CornerRadius="12" Margin="-10,2" Background="{DynamicResource Brush.Hover}" Visibility="Collapsed" />
              <c:FocusRing IsActive="{TemplateBinding IsFocused}" CornerRadius="12" Margin="-10,-3" Fill="{DynamicResource Brush.Focus.Fill}" />
              <ContentPresenter Margin="20,0,16,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter Property="Panel.ZIndex" Value="1" />
                <Setter TargetName="Hover" Property="Visibility" Value="Collapsed" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A small mark on a line: "Update" in the accent, the others quiet. -->
    <Style x:Key="ModChip" TargetType="Border">
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Outline}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ModChipText" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <c:PageHeader Title="{Binding S[mods.title]}" Icon="{StaticResource Icon.Package}" />
    <c:Spinner Grid.Row="1" Width="72" Height="72" Visibility="{Binding Loading, Converter={StaticResource Conv.Visible}}" />
    <c:SmoothScrollViewer Grid.Row="1" Padding="16,30,24,60" EdgePadding="110" input:FocusNav.IsGroup="True" HorizontalAlignment="Center" Width="1300"
                          Visibility="{Binding Loading, Converter={StaticResource Conv.Visible}, ConverterParameter=!}">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,26" Visibility="{Binding Note, Converter={StaticResource Conv.Visible}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:Icon Data="{StaticResource Icon.Info}" Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,20,0" Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock Grid.Column="1" Text="{Binding Note}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text}" />
          </Grid>
        </Border>
        <StackPanel Visibility="{Binding Supported, Converter={StaticResource Conv.Visible}}">
          <!-- one line for the three ways to get a mod: the store, wide (the page opens on it), then a link, then a file -->
          <Grid input:FocusNav.IsGroup="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:ConsoleButton Style="{StaticResource GetLine}" Kind="Primary" Icon="{StaticResource Icon.Search}" Content="{Binding S[mods.get]}"
                             Command="{Binding BrowseCommand}" HorizontalAlignment="Stretch" input:FocusNav.IsDefault="True" />
            <c:ConsoleButton Grid.Column="1" Style="{StaticResource GetLine}" Kind="Secondary" Icon="{StaticResource Icon.Globe}" Content="{Binding S[mods.from.link]}"
                             Command="{Binding LinkCommand}" Margin="16,0,0,0" />
            <c:ConsoleButton Grid.Column="2" Style="{StaticResource GetLine}" Kind="Secondary" Icon="{StaticResource Icon.File}" Content="{Binding S[mods.from.zip]}"
                             Command="{Binding FileCommand}" Margin="16,0,0,0" />
          </Grid>
          <!-- "Installed", the chips that filter it on the same line. "Turn all off" / "Turn all back on" is Y in the hint bar. -->
          <Grid>
            <c:SectionHeader Text="{Binding S[mods.installed]}" Margin="0,32,0,0" />
            <!-- centred on the header's text: 32 above it, 34 high, then 16 and the rule -->
            <ItemsControl ItemsSource="{Binding Filters}" Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8"
                          input:FocusNav.IsGroup="True" Visibility="{Binding HasFilters, Converter={StaticResource Conv.Visible}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <c:ConsoleButton Content="{Binding Label}" Command="{Binding SelectCommand}" Height="54" MinWidth="0" Padding="24,0" FontSize="22" Margin="10,0,0,0"
                                   Visibility="{Binding IsVisible, Converter={StaticResource Conv.Visible}}">
                    <c:ConsoleButton.Style>
                      <Style TargetType="c:ConsoleButton" BasedOn="{StaticResource {x:Type c:ConsoleButton}}">
                        <Setter Property="Kind" Value="Secondary" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Kind" Value="Primary" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </c:ConsoleButton.Style>
                  </c:ConsoleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          <ItemsControl x:Name="RowsHost" ItemsSource="{Binding Rows}" Focusable="False" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <!-- the buttons' columns are as wide on every line (the sizes and the switches line up) -->
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ModActions" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <!-- the line's rule, under its buttons and switch too -->
                  <Border Grid.ColumnSpan="3" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="0,0,0,1.5" />
                  <Button Style="{StaticResource ModLine}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <c:Icon Data="{Binding Icon, Converter={StaticResource Conv.Icon}}" Width="38" Height="38" Margin="0,0,22,0" VerticalAlignment="Center" />
                      <!-- the name first; version and author after it, small, while they fit (the line ends in "…" when not) -->
                      <TextBlock Grid.Column="1" Style="{StaticResource Text.Base}" FontSize="29" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="   " FontSize="21" /><Run Text="{Binding Detail, Mode=OneWay}" FontSize="21" Foreground="{DynamicResource Brush.TextMuted}" />
                      </TextBlock>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                        <Border Style="{StaticResource ModChip}" Visibility="{Binding ShowsCode, Converter={StaticResource Conv.Visible}}">
                          <TextBlock Text="{Binding S[mods.chip.code]}" Style="{StaticResource ModChipText}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Grid.Column="3" Text="{Binding Size}" Style="{StaticResource Text.Base}" FontSize="23" Foreground="{DynamicResource Brush.TextMuted}"
                                 MinWidth="112" TextAlignment="Right" Margin="18,0,0,0" />
                    </Grid>
                  </Button>
                  <!-- the line's own buttons, each a stop: Update (GameBanana has a newer file), Options (its drawer, as A on the line) -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <c:ConsoleButton Style="{StaticResource RowAction}" Kind="Outline" Icon="{StaticResource Icon.Download}"
                                     Content="{Binding S[mods.chip.update]}" Command="{Binding UpdateCommand}"
                                     Visibility="{Binding HasUpdate, Converter={StaticResource Conv.Visible}}" />
                    <c:ConsoleButton Style="{StaticResource RowAction}" Kind="Secondary"
                                     Content="{Binding S[mods.chip.options]}" Command="{Binding OpenCommand}"
                                     Visibility="{Binding ShowsOptions, Converter={StaticResource Conv.Visible}}" />
                  </StackPanel>
                  <!-- its own stop: Right from the line, A flips it; locked where the mod is (MKWMP's own, a code mod, the game running) -->
                  <c:ToggleSwitch Grid.Column="2" Margin="24,0,14,0" VerticalAlignment="Center" IsChecked="{Binding IsOn}" IsEnabled="{Binding CanToggle}"
                                  AutomationProperties.Name="{Binding SwitchName}" ToolTip="{Binding SwitchName}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="20,18,20,0" Visibility="{Binding IsEmpty, Converter={StaticResource Conv.Visible}}">
            <Image Source="pack://application:,,,/Assets/Art/empty-mods.png" Height="150" Margin="0,0,26,0"
                   RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
            <TextBlock Text="{Binding S[mods.empty]}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="1000" />
          </StackPanel>
          <TextBlock Text="{Binding S[mods.filter.none]}" Style="{StaticResource Text.Caption}" Margin="20,24,20,0"
                     Visibility="{Binding IsFilteredEmpty, Converter={StaticResource Conv.Visible}}" />
          <TextBlock Text="{Binding S[mods.restart]}" Style="{StaticResource Text.Caption}" Margin="20,18,20,0" />

        </StackPanel>
      </StackPanel>
    </c:SmoothScrollViewer>
  </Grid>
</UserControl>
