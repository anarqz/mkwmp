<UserControl x:Class="Mkwmp.App.Views.Mods.ModBrowserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             xmlns:mods="clr-namespace:Mkwmp.App.Views.Mods"
             Focusable="False">
  <!-- DataContext: ModBrowserViewModel. GameBanana's mods of the game: the search and the order on top, a grid of cards, the pages. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <c:PageHeader Title="{Binding S[mods.get]}" Icon="{StaticResource Icon.Search}">
      <TextBlock Text="GameBanana" Style="{StaticResource Text.Small}" FontSize="23" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </c:PageHeader>
    <c:SmoothScrollViewer Grid.Row="1" Padding="16,26,24,60" EdgePadding="110" input:FocusNav.IsGroup="True" HorizontalAlignment="Center" Width="1560">
      <StackPanel>
        <Grid Margin="12,0,12,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid>
            <TextBox Text="{Binding Query, UpdateSourceTrigger=LostFocus}" MaxLength="80" FontSize="30" Padding="68,0,24,0"
                     input:TextEntry.Title="{Binding S[mods.browse.search]}" />
            <c:Icon Data="{StaticResource Icon.Search}" Width="34" Height="34" Margin="22,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
            <TextBlock Text="{Binding S[mods.browse.search]}" Style="{StaticResource Text.Base}" FontSize="30" Foreground="{DynamicResource Brush.TextFaint}" Margin="70,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Query, Converter={StaticResource Conv.Visible}, ConverterParameter=!}" />
          </Grid>
          <c:ConsoleButton Grid.Column="1" Margin="18,0,0,0" MinWidth="330" Content="{Binding SortText}" Command="{Binding SortCommand}"
                           IsEnabled="{Binding IsSearching, Converter={StaticResource Conv.Not}}" />
          <c:ConsoleButton Grid.Column="2" Margin="18,0,0,0" Icon="{StaticResource Icon.Eye}" Content="{Binding MatureText}" Command="{Binding MatureCommand}" />
        </Grid>
        <TextBlock Text="{Binding S[mods.browse.note]}" Style="{StaticResource Text.Caption}" FontSize="23" Margin="16,10,16,18" />

        <c:Spinner Width="72" Height="72" Margin="0,120,0,120" Visibility="{Binding Loading, Converter={StaticResource Conv.Visible}}" />
        <Border Style="{StaticResource Card}" Margin="12,20,12,0" Visibility="{Binding Error, Converter={StaticResource Conv.Visible}}">
          <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Bad}" />
        </Border>
        <TextBlock Text="{Binding S[mods.browse.none]}" Style="{StaticResource Text.Caption}" Margin="16,40,16,0" HorizontalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource Conv.Visible}}" />

        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" Visibility="{Binding Loading, Converter={StaticResource Conv.Visible}, ConverterParameter=!}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource CardButton}" Command="{Binding OpenCommand}" Width="352" Margin="11" Padding="14,14,14,16" VerticalContentAlignment="Top">
                <StackPanel>
                  <Grid Height="186">
                    <Grid ClipToBounds="True">
                      <Border Background="{Binding Picture.Seed, Converter={StaticResource Conv.Art}}" CornerRadius="10" />
                      <c:Icon Data="{StaticResource Icon.Package}" Width="64" Height="64" Foreground="#CCFFFFFF" StrokeThickness="1.8"
                              Visibility="{Binding Picture.HasImage, Converter={StaticResource Conv.Visible}, ConverterParameter=!}" />
                      <Border CornerRadius="10" Visibility="{Binding Picture.HasImage, Converter={StaticResource Conv.Visible}}">
                        <Border.Background>
                          <ImageBrush ImageSource="{Binding Picture.Image}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                      </Border>
                    </Grid>
                    <Border Style="{StaticResource Pill}" Height="38" Padding="14,0" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource Brush.Modal}"
                            Visibility="{Binding Badge, Converter={StaticResource Conv.Visible}}">
                      <TextBlock Text="{Binding Badge}" Style="{StaticResource Text.Small}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Base}" FontSize="26" FontWeight="SemiBold" Margin="4,14,4,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" FontSize="21" Margin="4,4,4,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="12,26,12,0" Visibility="{Binding HasPages, Converter={StaticResource Conv.Visible}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:ConsoleButton Icon="{StaticResource Icon.ChevronLeft}" Content="{Binding S[mods.browse.prev]}" Command="{Binding PreviousCommand}" MinWidth="300" />
          <TextBlock Grid.Column="1" Text="{Binding PageText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <c:ConsoleButton Grid.Column="2" Icon="{StaticResource Icon.ChevronRight}" Content="{Binding S[mods.browse.next]}" Command="{Binding NextCommand}" MinWidth="300" />
        </Grid>
      </StackPanel>
    </c:SmoothScrollViewer>
  </Grid>
</UserControl>