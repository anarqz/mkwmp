<UserControl x:Class="Mkwmp.App.Views.Settings.StatusLines"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             Focusable="False">
  <!-- DataContext: IReadOnlyList<StatusLine>. One line each: a light (good / warn / bad / muted, or a
       spinner for busy), the text, and a smaller detail under it. -->
  <ItemsControl ItemsSource="{Binding}" Focusable="False">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Grid Margin="20,18,20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Width="30">
            <Ellipse x:Name="Light" Width="18" Height="18" Fill="{DynamicResource Brush.TextFaint}" />
            <c:Spinner x:Name="Busy" Width="28" Height="28" Visibility="Collapsed" />
          </Grid>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" FontSize="28" LineHeight="40" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" FontSize="23" LineHeight="33" Margin="0,2,0,0"
                       Visibility="{Binding Detail, Converter={StaticResource Conv.Visible}}" />
          </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="good">
            <Setter TargetName="Light" Property="Fill" Value="{DynamicResource Brush.Good}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="warn">
            <Setter TargetName="Light" Property="Fill" Value="{DynamicResource Brush.Warn}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="bad">
            <Setter TargetName="Light" Property="Fill" Value="{DynamicResource Brush.Bad}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="busy">
            <Setter TargetName="Light" Property="Visibility" Value="Collapsed" />
            <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
