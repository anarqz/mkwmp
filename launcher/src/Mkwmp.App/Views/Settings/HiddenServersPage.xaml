<UserControl x:Class="Mkwmp.App.Views.Settings.HiddenServersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             x:Name="Self" Focusable="False">
  <!-- DataContext: HiddenServersViewModel. The servers taken out of the server list on this PC: A on one
       shows it again in the list. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <c:PageHeader Title="{Binding Title}" Icon="{StaticResource Icon.EyeOff}" />
    <c:SmoothScrollViewer Grid.Row="1" Padding="16,26,24,60" EdgePadding="110" input:FocusNav.IsGroup="True" HorizontalAlignment="Center" Width="1300">
      <StackPanel>
        <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Caption}" Margin="20,0,20,18" />
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <c:SettingsRow Label="{Binding Name}" Caption="{Binding Detail}" Icon="{StaticResource Icon.Globe}"
                             Value="{Binding DataContext.ShowLabel, ElementName=Self}" Kind="Chevron" Command="{Binding ShowCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </c:SmoothScrollViewer>
  </Grid>
</UserControl>
