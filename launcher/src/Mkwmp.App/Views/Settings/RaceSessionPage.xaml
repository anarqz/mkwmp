<UserControl x:Class="Mkwmp.App.Views.Settings.RaceSessionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             x:Name="Self" Focusable="False">
  <!-- DataContext: RaceSessionViewModel. One online session of Previous Races: when its races started (one line), then
       everyone met in it. A player who showed more than one name under the same Player ID is flagged in the warning
       colour ("Used 3 names") with those names under theirs, and listed first; this PC's player is marked "You".
       A on a player opens them. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <c:PageHeader Title="{Binding Title}" Icon="{StaticResource Icon.Trophy}">
      <TextBlock Text="{Binding Network}" Style="{StaticResource Text.Small}" FontSize="23" VerticalAlignment="Center" />
    </c:PageHeader>
    <c:SmoothScrollViewer Grid.Row="1" Padding="16,26,24,60" EdgePadding="110" input:FocusNav.IsGroup="True" HorizontalAlignment="Center" Width="1300">
      <StackPanel>
        <c:Spinner Width="56" Height="56" Margin="0,40,0,0" Visibility="{Binding Loading, Converter={StaticResource Conv.Visible}}" />
        <TextBlock Text="{Binding S[races.gone]}" Style="{StaticResource Text.Caption}" Margin="20,26,20,0"
                   Visibility="{Binding Gone, Converter={StaticResource Conv.Visible}}" />
        <StackPanel Visibility="{Binding Found, Converter={StaticResource Conv.Visible}}">
          <c:SectionHeader Text="{Binding RacesHeader}" Margin="0,0,0,0" />
          <TextBlock Text="{Binding RacesText}" Style="{StaticResource Text.Caption}" FontSize="26" LineHeight="38" Margin="20,16,20,0" />
          <c:SectionHeader Text="{Binding PlayersHeader}" />
          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource CardButton}" Background="Transparent" Padding="16,12" Margin="0,2" Command="{Binding OpenCommand}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:Avatar DisplayName="{Binding Name}" Width="72" Height="72" />
                    <StackPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontSize="30" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Names}" Style="{StaticResource Text.Small}" FontSize="22" TextTrimming="CharacterEllipsis"
                                 Visibility="{Binding Names, Converter={StaticResource Conv.Visible}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                Visibility="{Binding Renamed, Converter={StaticResource Conv.Visible}}">
                      <c:Icon Data="{StaticResource Icon.Warning}" Width="30" Height="30" StrokeThickness="2.2" Foreground="{DynamicResource Brush.Warn}" Margin="0,0,10,0" />
                      <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Brush.Warn}" Style="{StaticResource Text.Base}" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="3" Style="{StaticResource Pill}" Height="42" Padding="18,0" Margin="12,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsYou, Converter={StaticResource Conv.Visible}}">
                      <TextBlock Text="{Binding DataContext.YouLabel, ElementName=Self}" Style="{StaticResource Text.Base}" FontSize="22" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                    </Border>
                    <c:Icon Grid.Column="4" Data="{StaticResource Icon.ChevronRight}" Width="30" Height="30" Margin="18,0,0,0" VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.TextMuted}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </c:SmoothScrollViewer>
  </Grid>
</UserControl>
