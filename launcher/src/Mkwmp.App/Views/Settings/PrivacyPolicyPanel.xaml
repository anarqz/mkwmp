<UserControl x:Class="Mkwmp.App.Views.Settings.PrivacyPolicyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:settings="clr-namespace:Mkwmp.App.Views.Settings"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             Focusable="False">
  <!-- DataContext: PrivacyViewModel. THE privacy component: the content of the welcome flow's consent page, which
       Settings › Online's Privacy Policy row also opens (alone): what MKWMP's servers keep, then the server's own policy (MarkdownView: each
       section a card the D-pad stops on), scrolling; and under them, always on screen, "I'm 18 or older and I accept
       the privacy policy". The switch is at the bottom because it comes after the text, and stays put so nobody
       scrolls a whole policy to reach it; the focus starts on it. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <c:Spinner Width="72" Height="72" Visibility="{Binding Loading, Converter={StaticResource Conv.Visible}}" />
    <c:SmoothScrollViewer Padding="16,22,24,30" EdgePadding="110" FadeEdges="50" input:FocusNav.IsGroup="True"
                          Visibility="{Binding Loading, Converter={StaticResource Conv.Visible}, ConverterParameter=!}">
      <StackPanel>
        <!-- what every MKWMP server keeps, before the server's own words -->
        <StackPanel Margin="20,0,20,18">
          <TextBlock Text="{Binding Lead}" Style="{StaticResource Text.Caption}" FontSize="24" Margin="0,0,0,10"
                     Visibility="{Binding Lead, Converter={StaticResource Conv.Visible}}" />
          <TextBlock Text="{Binding S[setup.consent.p1]}" Style="{StaticResource Text.Body}" FontSize="30" LineHeight="42" />
          <TextBlock Text="{Binding S[setup.consent.p2]}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
          <TextBlock Text="{Binding S[setup.consent.p3]}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
          <!-- what the launcher itself keeps of other players: nothing (the current lobby is in memory only) -->
          <TextBlock Text="{Binding S[setup.consent.p4]}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
        </StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding Note, Converter={StaticResource Conv.Visible}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:Icon Data="{StaticResource Icon.Info}" Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,20,0" Foreground="{DynamicResource Brush.Warn}" />
            <TextBlock Grid.Column="1" Text="{Binding Note}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text}" />
          </Grid>
        </Border>
        <!-- whose policy this is, and the version a consent names -->
        <StackPanel Orientation="Horizontal" Margin="20,6,20,10" Visibility="{Binding Source, Converter={StaticResource Conv.Visible}}">
          <c:Icon Data="{StaticResource Icon.Shield}" Width="30" Height="30" StrokeThickness="1.9" Margin="0,0,12,0" Foreground="{DynamicResource Brush.TextMuted}" />
          <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Small}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Small}" FontSize="20" Margin="16,2,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <settings:MarkdownView Markdown="{Binding Markdown}" LinkCommand="{Binding LinkCommand}" />
      </StackPanel>
    </c:SmoothScrollViewer>

    <!-- the acceptance, after the text: given or withdrawn here, at once -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,4,14,4" Margin="16,8,24,0">
      <Grid>
        <c:SettingsRow Label="{Binding S[setup.consent.adult]}" Kind="Toggle" IsOn="{Binding Accepted}" IsEnabled="{Binding CanChange}"
                       Caption="{Binding AcceptCaption}" ShowRule="False" input:FocusNav.IsDefault="True"
                       Visibility="{Binding ShowAccept, Converter={StaticResource Conv.Visible}}" />
        <!-- nobody to take a consent from yet -->
        <StackPanel Orientation="Horizontal" Margin="20,22" Visibility="{Binding ShowAccept, Converter={StaticResource Conv.Visible}, ConverterParameter=!}">
          <c:Icon Data="{StaticResource Icon.Info}" Width="38" Height="38" Margin="0,0,18,0" Foreground="{DynamicResource Brush.TextMuted}" />
          <TextBlock Text="{Binding NoProfileText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
