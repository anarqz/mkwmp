<UserControl x:Class="Mkwmp.App.Views.Settings.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             Focusable="False">
  <!-- DataContext: ReportViewModel. Settings › Online › Report Abuse: who, what happened, optional details, Send.
       While a report waits for the host's review: that report, and Withdraw. -->
  <UserControl.Resources>
    <Style x:Key="Field" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}" />
      <Setter Property="BorderThickness" Value="0,0,0,1.5" />
      <Setter Property="Padding" Value="20,14,20,14" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="Margin" Value="20,16,20,0" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <c:PageHeader Title="{Binding S[settings.report.title]}" Icon="{StaticResource Icon.Flag}">
      <TextBlock Text="{Binding Server}" Style="{StaticResource Text.Small}" FontSize="23" VerticalAlignment="Center" />
    </c:PageHeader>
    <c:SmoothScrollViewer Grid.Row="1" Padding="16,26,24,60" EdgePadding="110" input:FocusNav.IsGroup="True" HorizontalAlignment="Center" Width="1300">
      <StackPanel>
        <TextBlock Text="{Binding S[settings.report.caption]}" Style="{StaticResource Text.Caption}" Margin="20,0,20,6" />

        <TextBlock Text="{Binding S[settings.report.gate]}" Style="{StaticResource Note}"
                   Visibility="{Binding State, Converter={StaticResource Conv.Visible}, ConverterParameter='=gate'}" />
        <StackPanel Orientation="Horizontal" Margin="20,22,20,0"
                    Visibility="{Binding State, Converter={StaticResource Conv.Visible}, ConverterParameter='=checking'}">
          <c:Spinner Width="34" Height="34" Margin="0,0,16,0" />
          <TextBlock Text="{Binding Checking}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- one is waiting: it, and the way to take it back -->
        <StackPanel Visibility="{Binding State, Converter={StaticResource Conv.Visible}, ConverterParameter='=open'}">
          <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <c:Icon Data="{StaticResource Icon.Clock}" Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,20,0" Foreground="{DynamicResource Brush.Accent}" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding OpenText}" Style="{StaticResource Text.Body}" />
                <TextBlock Text="{Binding S[settings.report.one]}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
              </StackPanel>
            </Grid>
          </Border>
          <c:SettingsRow Label="{Binding S[settings.report.withdraw]}" Icon="{StaticResource Icon.Close}" Command="{Binding WithdrawCommand}" Margin="0,12,0,0" />
        </StackPanel>

        <!-- the form -->
        <StackPanel Visibility="{Binding State, Converter={StaticResource Conv.Visible}, ConverterParameter='=form'}" Margin="0,10,0,0">
          <Border Style="{StaticResource Field}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="300" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding S[settings.profile.gamertag]}" Style="{StaticResource Text.Base}" FontSize="32" Margin="0,0,28,0" />
              <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" input:FocusNav.IsDefault="True"
                       input:TextEntry.Placeholder="{Binding S[settings.report.name_hint]}"
                       input:TextEntry.Title="{Binding S[settings.profile.gamertag]}" input:TextEntry.Charset="Gamertag" />
            </Grid>
          </Border>
          <c:SettingsRow Label="{Binding S[settings.report.what]}" Kind="Chevron" Value="{Binding ReasonName}" Command="{Binding ReasonCommand}" />
          <Border Style="{StaticResource Field}">
            <TextBox Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}" Height="190" Padding="26,20" VerticalContentAlignment="Top"
                     MaxLength="{Binding DetailsMax, Mode=OneTime}" TextWrapping="Wrap" FontSize="28"
                     input:TextEntry.Placeholder="{Binding S[settings.report.details_hint]}" input:TextEntry.Title="{Binding S[settings.report.what]}" />
          </Border>
          <c:ConsoleButton Kind="Primary" Icon="{StaticResource Icon.Flag}" Content="{Binding S[settings.report.send]}" Command="{Binding SendCommand}"
                           HorizontalAlignment="Left" MinWidth="420" Margin="20,26,0,0" />
        </StackPanel>

        <TextBlock Text="{Binding Note}" Margin="20,18,20,0" Visibility="{Binding Note, Converter={StaticResource Conv.Visible}}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Good}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding NoteIsError}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </c:SmoothScrollViewer>
  </Grid>
</UserControl>
