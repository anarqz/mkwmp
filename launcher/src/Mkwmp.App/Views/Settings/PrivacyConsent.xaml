<UserControl x:Class="Mkwmp.App.Views.Settings.PrivacyConsent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             x:Name="Self" Focusable="False">
  <!-- Privacy, in one place: "I'm 18 or older and I accept the privacy policy" and, right under it, the policy it
       speaks of. One card of two rows, the same wherever consent is shown (Settings › Online, the welcome flow's
       consent page). The DataContext gives S; the rest are this control's properties: Accepted (two-way),
       ShowAccept (false: only the policy row, for a player with no profile on the server yet), AcceptCaption,
       CanChange, PolicyCommand. -->
  <Border Style="{StaticResource Card}" Padding="14,4,14,4">
    <StackPanel>
      <c:SettingsRow x:Name="AcceptRow" Label="{Binding S[setup.consent.adult]}" Kind="Toggle"
                     IsOn="{Binding Accepted, ElementName=Self, Mode=TwoWay}" IsEnabled="{Binding CanChange, ElementName=Self}"
                     Caption="{Binding AcceptCaption, ElementName=Self}"
                     Visibility="{Binding ShowAccept, ElementName=Self, Converter={StaticResource Conv.Visible}}" />
      <c:SettingsRow Label="{Binding S[settings.privacy.policy]}" Kind="Chevron" Icon="{StaticResource Icon.Shield}" ShowRule="False"
                     Command="{Binding PolicyCommand, ElementName=Self}" Caption="{Binding S[settings.privacy.policy_caption]}" />
    </StackPanel>
  </Border>
</UserControl>
