<UserControl x:Class="Mkwmp.App.Views.Settings.ChoiceList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             Focusable="False">
  <!-- DataContext: ChoiceListViewModel (the content of a selection modal). Every option is a row;
       the current one is ticked and has the focus when the modal opens. -->
  <c:SmoothScrollViewer MaxHeight="452" Padding="14,4,22,4" input:FocusNav.IsGroup="True">
    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <c:SettingsRow Label="{Binding Label}" Caption="{Binding Caption}" Command="{Binding Command}"
                         input:FocusNav.IsDefault="{Binding IsSelected}">
            <c:Icon Data="{StaticResource Icon.Check}" Width="40" Height="40" StrokeThickness="2.6"
                    Foreground="{DynamicResource Brush.Accent}"
                    Visibility="{Binding IsSelected, Converter={StaticResource Conv.Visible}}" />
          </c:SettingsRow>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </c:SmoothScrollViewer>
</UserControl>
