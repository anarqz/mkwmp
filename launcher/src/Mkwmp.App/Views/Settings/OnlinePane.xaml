<UserControl x:Class="Mkwmp.App.Views.Settings.OnlinePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:settings="clr-namespace:Mkwmp.App.Views.Settings"
             Focusable="False">
  <!-- DataContext: SettingsViewModel (SettingsViewModel.Online.cs). Settings › Online, where "Configure
       Online" leads from every locked place. Without a server: "Online is off" and Connect to a Server (the
       welcome flow's online pages). With one: the server and its status, the profile on it with its PIN
       (dots until the eye, or X), Disconnect, privacy, and deleting the profile on that server. -->
  <UserControl.Resources>
    <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="Margin" Value="20,16,20,0" />
    </Style>
    <Style x:Key="FactIcon" TargetType="c:Icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="StrokeThickness" Value="1.9" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,2,22,0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style x:Key="Fact" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="LineHeight" Value="37" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
  <Grid>
    <!-- ───────── offline: online is off ───────── -->
    <StackPanel Visibility="{Binding OnlineLocked, Converter={StaticResource Conv.Visible}}">
      <Border Style="{StaticResource Card}" Margin="0,38,0,0" Padding="34,30">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Grid Width="84" Height="84">
              <Ellipse Fill="{DynamicResource Brush.Background}" />
              <c:Icon Data="{StaticResource Icon.SignalOff}" Width="44" Height="44" Foreground="{DynamicResource Brush.TextMuted}" />
            </Grid>
            <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding S[settings.online.off]}" Style="{StaticResource Text.Heading}" />
              <TextBlock Text="{Binding S[settings.online.off_text]}" Style="{StaticResource Text.Caption}" />
            </StackPanel>
          </StackPanel>
          <Border Height="1.5" Background="{DynamicResource Brush.Rule}" Margin="0,24,0,22" />
          <StackPanel Orientation="Horizontal">
            <c:Icon Data="{StaticResource Icon.Globe}" Style="{StaticResource FactIcon}" />
            <TextBlock Text="{Binding S[setup.online.races_text]}" Style="{StaticResource Fact}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <c:Icon Data="{StaticResource Icon.Friends}" Style="{StaticResource FactIcon}" />
            <TextBlock Text="{Binding S[setup.online.friends_text]}" Style="{StaticResource Fact}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <c:Icon Data="{StaticResource Icon.Mic}" Style="{StaticResource FactIcon}" />
            <TextBlock Text="{Binding S[setup.online.voice_text]}" Style="{StaticResource Fact}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- the servers that announce themselves, nearest first; choosing one connects to it -->
      <StackPanel Visibility="{Binding Servers.HasList, Converter={StaticResource Conv.Visible}}">
        <Grid Margin="0,34,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:SectionHeader Text="{Binding S[settings.online.servers]}" Margin="0" ShowRule="False" VerticalAlignment="Center" />
          <c:ConsoleButton Grid.Column="1" Kind="Ghost" Height="68" MinWidth="0" Padding="22,0" Icon="{StaticResource Icon.Refresh}" Content="{Binding S[servers.refresh]}"
                           Command="{Binding Servers.RefreshCommand}" />
        </Grid>
        <settings:ServerList DataContext="{Binding Servers}" Margin="0,10,0,0" />
      </StackPanel>
      <c:SettingsRow Label="{Binding TypeAddressLabel}" Kind="Chevron" Icon="{StaticResource Icon.Globe}" Margin="0,12,0,0"
                     Command="{Binding ConnectCommand}" Caption="{Binding ConnectCaption}" />
      <TextBlock Text="{Binding S[settings.online.off_note]}" Style="{StaticResource Note}" />
      <TextBlock Text="{Binding BusyNote}" Style="{StaticResource Note}" Visibility="{Binding BusyNote, Converter={StaticResource Conv.Visible}}" />
    </StackPanel>

    <!-- ───────── online ───────── -->
    <StackPanel Visibility="{Binding OnlineEnabled, Converter={StaticResource Conv.Visible}}">
      <!-- the profile on this server, with its PIN -->
      <Border Style="{StaticResource Card}" Margin="0,38,0,0" DataContext="{Binding Profile}"
              Visibility="{Binding SignedIn, Converter={StaticResource Conv.Visible}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:Avatar DisplayName="{Binding SavedName}" Width="116" Height="116" />
          <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding SavedName}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding S[settings.profile.signed_in]}" Style="{StaticResource Text.Caption}" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,0,0">
            <TextBlock Text="{Binding S[settings.profile.pin]}" Style="{StaticResource Text.Small}" Margin="2,0,0,2" />
            <settings:PinField Pin="{Binding SavedPin}" IsRevealed="{Binding PinRevealed}" DigitSize="46" />
          </StackPanel>
        </Grid>
      </Border>

      <c:SectionHeader Text="{Binding S[settings.online.server]}" />
      <c:SettingsRow Label="{Binding S[settings.server.url]}" Kind="Chevron" Icon="{StaticResource Icon.Globe}" Value="{Binding ServerShort}"
                     Command="{Binding ConnectCommand}" Caption="{Binding S[settings.online.change_caption]}" />
      <settings:StatusLines DataContext="{Binding ServerLines}" />
      <TextBlock Text="{Binding SeatsText}" Style="{StaticResource Note}" Margin="66,2,20,0"
                 Visibility="{Binding SeatsText, Converter={StaticResource Conv.Visible}}" />
      <c:SettingsRow Label="{Binding S[settings.online.disconnect]}" Icon="{StaticResource Icon.SignalOff}" Margin="0,14,0,0"
                     Command="{Binding DisconnectCommand}" Caption="{Binding DisconnectCaption}" />

      <!-- no profile on this server yet (or another gamertag is being entered) -->
      <StackPanel DataContext="{Binding Profile}" Visibility="{Binding ShowEntry, Converter={StaticResource Conv.Visible}}">
        <c:SectionHeader Text="{Binding S[settings.online.register]}" />
        <settings:ProfileEntry Margin="0,26,0,0" />
        <c:SettingsRow Label="{Binding S[settings.profile.keep]}" Value="{Binding SavedName}" Kind="Chevron" Margin="0,26,0,0"
                       Command="{Binding CancelEditCommand}" Caption="{Binding S[settings.profile.keep_caption]}"
                       Visibility="{Binding Editing, Converter={StaticResource Conv.Visible}}" />
      </StackPanel>
      <StackPanel DataContext="{Binding Profile}" Visibility="{Binding SignedIn, Converter={StaticResource Conv.Visible}}">
        <c:SectionHeader Text="{Binding S[settings.online.profile]}" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Note}" />
        <c:SettingsRow Label="{Binding S[settings.profile.change]}" Kind="Chevron" Icon="{StaticResource Icon.User}" Margin="0,8,0,0"
                       Command="{Binding EditCommand}" Caption="{Binding S[settings.profile.change_caption]}" />
      </StackPanel>

      <c:SectionHeader Text="{Binding S[settings.privacy]}" />
      <Border Style="{StaticResource Card}" Margin="0,18,0,6">
        <StackPanel>
          <TextBlock Text="{Binding S[setup.consent.p1]}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text}" />
          <TextBlock Text="{Binding S[setup.consent.p2]}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
          <TextBlock Text="{Binding S[setup.consent.p3]}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
        </StackPanel>
      </Border>
      <!-- signed in without the consent this server keeps: one way, the consent page -->
      <c:SettingsRow Label="{Binding S[settings.privacy.review]}" Kind="Chevron" Icon="{StaticResource Icon.Warning}"
                     Command="{Binding ConsentCommand}" Caption="{Binding S[settings.privacy.review_caption]}"
                     Visibility="{Binding ConsentNeeded, Converter={StaticResource Conv.Visible}}" />
      <c:SettingsRow Label="{Binding S[setup.consent.adult]}" Kind="Toggle" IsOn="{Binding Adult}" IsEnabled="{Binding NotBusy}"
                     Caption="{Binding S[settings.privacy.adult_caption]}"
                     Visibility="{Binding ConsentGiven, Converter={StaticResource Conv.Visible}}" />
      <c:SettingsRow Label="{Binding S[settings.privacy.policy]}" Kind="Chevron" Icon="{StaticResource Icon.Shield}"
                     Command="{Binding PrivacyCommand}" Caption="{Binding S[settings.privacy.policy_caption]}" />

      <StackPanel DataContext="{Binding Profile}" Visibility="{Binding SignedIn, Converter={StaticResource Conv.Visible}}">
        <c:SectionHeader Text="{Binding S[settings.profile.delete_section]}" />
        <c:SettingsRow Label="{Binding S[settings.profile.delete]}" Icon="{StaticResource Icon.Trash}"
                       Command="{Binding DeleteCommand}" Caption="{Binding S[settings.privacy.delete_caption]}" />
      </StackPanel>
      <TextBlock Text="{Binding BusyNote}" Style="{StaticResource Note}" Visibility="{Binding BusyNote, Converter={StaticResource Conv.Visible}}" />
    </StackPanel>
  </Grid>

  <!-- ───────── where the server list comes from (both states) ───────── -->
  <c:SectionHeader Text="{Binding S[settings.online.announcer]}" />
  <Grid Margin="0,22,0,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBox Text="{Binding AnnouncerAddress, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Height="76" FontSize="28"
             VerticalContentAlignment="Center" IsEnabled="{Binding NotBusy}" />
    <c:ConsoleButton Grid.Column="1" Content="{Binding S[settings.online.announcer_save]}" Command="{Binding SaveAnnouncerCommand}"
                     Height="76" MinWidth="0" Padding="30,0" Margin="16,0,0,0" />
  </Grid>
  <TextBlock Text="{Binding AnnouncerNote}">
    <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding AnnouncerNoteIsError}" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </TextBlock.Style>
  </TextBlock>
  <c:SettingsRow Label="{Binding S[settings.online.announcer_reset]}" Icon="{StaticResource Icon.Refresh}" Margin="0,14,0,0"
                 Command="{Binding DefaultAnnouncerCommand}" Caption="{Binding S[settings.online.announcer_reset_caption]}"
                 Visibility="{Binding AnnouncerCustom, Converter={StaticResource Conv.Visible}}" />
  </StackPanel>
</UserControl>
