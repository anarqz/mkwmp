<UserControl x:Class="Mkwmp.App.Views.Settings.OnlinePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:settings="clr-namespace:Mkwmp.App.Views.Settings"
             xmlns:v="clr-namespace:Mkwmp.App.Views"
             Focusable="False">
  <!-- DataContext: SettingsViewModel (SettingsViewModel.Online.cs). Settings › Online. On top, where PLAY goes
       online: Nextendo Network (the account; or, with nobody signed in, what signing in does and the rows that sign
       in or create an account). Then "Alternative: MKWMP Servers" with its switch, the one place where MKWMP
       servers are chosen. Only with it on is what follows shown, an MKWMP server's (and the top is one row that
       leads back to Nextendo). Without a server: "Online is off" and Connect to a Server (SetupViewModel's connect
       pages, which ask for that server's consent). With one: the profile on it with its PIN (dots until the eye, or X); the server
       on ONE row (its address, its status in small text, Disconnect), and right below it what else is about that
       server: the Privacy Policy row (accepted or not; the page it opens has the policy and its acceptance), reporting a player to its host, and Connect to Another Server (the way to swap:
       the server row itself is not a button); then the profile, the consent, and deleting the profile there. -->
  <UserControl.Resources>
    <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="Margin" Value="20,16,20,0" />
    </Style>
    <Style x:Key="FactIcon" TargetType="c:Icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="StrokeThickness" Value="1.9" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,2,22,0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style x:Key="Fact" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="LineHeight" Value="37" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
  <!-- ───────── Nextendo Network: where PLAY goes online ───────── -->
  <!-- signed in: the account, and what stays an MKWMP server's -->
  <StackPanel Visibility="{Binding ShowNextendoAccount, Converter={StaticResource Conv.Visible}}">
    <Border Style="{StaticResource Card}" Margin="0,38,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <c:Avatar DisplayName="{Binding NextendoName}" Width="116" Height="116" />
        <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding S[settings.online.nextendo]}" Style="{StaticResource Text.Title}" />
          <TextBlock Text="{Binding NextendoOnlineText}" Style="{StaticResource Text.Caption}" />
        </StackPanel>
      </Grid>
    </Border>
    <settings:NextendoFacts />
    <c:SettingsRow Label="{Binding S[settings.online.nextendo_account]}" Kind="Chevron" Icon="{StaticResource Icon.User}"
                   Value="{Binding NextendoName}" Command="{Binding NextendoPaneCommand}" />
  </StackPanel>
  <!-- nobody signed in: what it is, and the two ways in (while the browser is awaited: a spinner and Cancel) -->
  <StackPanel Visibility="{Binding ShowNextendoSignIn, Converter={StaticResource Conv.Visible}}">
    <Border Style="{StaticResource Card}" Margin="0,38,0,0" Padding="34,30">
      <StackPanel Orientation="Horizontal">
        <Grid Width="84" Height="84" VerticalAlignment="Top">
          <Ellipse Fill="{DynamicResource Brush.Background}" />
          <c:Icon Data="{StaticResource Icon.Globe}" Width="44" Height="44" Foreground="{DynamicResource Brush.Accent}" />
        </Grid>
        <StackPanel Margin="24,0,0,0" VerticalAlignment="Center" MaxWidth="900">
          <TextBlock Text="{Binding S[setup.online.heading]}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding S[nextendo.about]}" Style="{StaticResource Text.Caption}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <StackPanel Margin="0,18,0,0" Visibility="{Binding NextendoCanLink, Converter={StaticResource Conv.Visible}}">
      <c:SettingsRow Label="{Binding S[nextendo.signin]}" Kind="Chevron" Icon="{StaticResource Icon.User}"
                     Command="{Binding LinkNextendoCommand}" Caption="{Binding S[nextendo.link_caption]}" />
      <c:SettingsRow Label="{Binding S[nextendo.create]}" Kind="Chevron" Icon="{StaticResource Icon.UserPlus}"
                     Command="{Binding CreateNextendoCommand}" Caption="https://nextendo.network/register.html" />
    </StackPanel>
    <c:SettingsRow Label="{Binding S[common.cancel]}" Margin="0,18,0,0" Command="{Binding CancelNextendoLinkCommand}"
                   Caption="{Binding NextendoNote}"
                   Visibility="{Binding NextendoLinking, Converter={StaticResource Conv.Visible}}">
      <c:Spinner Width="40" Height="40" />
    </c:SettingsRow>
    <TextBlock Text="{Binding NextendoNote}" Visibility="{Binding ShowNextendoNote, Converter={StaticResource Conv.Visible}}">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding NextendoNoteIsError}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </StackPanel>
  <!-- MKWMP servers are chosen: one row that leads to Nextendo (who is signed in, or "Sign in with Nextendo") -->
  <c:SettingsRow Label="{Binding S[nextendo.title]}" Kind="Chevron" Icon="{StaticResource Icon.Globe}" Margin="0,22,0,0"
                 Value="{Binding NextendoRowValue}" Command="{Binding NextendoPaneCommand}" Caption="{Binding S[settings.online.nextendo_row]}"
                 Visibility="{Binding ShowNextendoRow, Converter={StaticResource Conv.Visible}}" />

  <!-- ───────── the alternative: MKWMP servers (the one place where they are chosen) ───────── -->
  <StackPanel Visibility="{Binding ShowUseMkwmp, Converter={StaticResource Conv.Visible}}">
    <c:SectionHeader Text="{Binding S[settings.online.alt]}" />
    <c:SettingsRow Label="{Binding S[settings.online.use_mkwmp]}" Kind="Toggle" IsOn="{Binding UseMkwmp}" IsEnabled="{Binding NotBusy}"
                   Caption="{Binding UseMkwmpCaption}" />
    <TextBlock Text="{Binding S[settings.online.nextendo_note]}" Style="{StaticResource Note}"
               Visibility="{Binding NextendoFirst, Converter={StaticResource Conv.Visible}}" />
  </StackPanel>
  <Grid>    <!-- ───────── offline: online is off ───────── -->
    <!-- offline only until MKWMP is updated: one reason, and the way back to the update -->
    <v:OnlineLocked Margin="0,96,0,40" Visibility="{Binding UpdateOffline, Converter={StaticResource Conv.Visible}}" />
    <StackPanel Visibility="{Binding ShowOnlineOff, Converter={StaticResource Conv.Visible}}">
      <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="34,30">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Grid Width="84" Height="84">
              <Ellipse Fill="{DynamicResource Brush.Background}" />
              <c:Icon Data="{StaticResource Icon.SignalOff}" Width="44" Height="44" Foreground="{DynamicResource Brush.TextMuted}" />
            </Grid>
            <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding S[settings.online.off]}" Style="{StaticResource Text.Heading}" />
              <TextBlock Text="{Binding S[settings.online.off_text]}" Style="{StaticResource Text.Caption}" />
            </StackPanel>
          </StackPanel>
          <Border Height="1.5" Background="{DynamicResource Brush.Rule}" Margin="0,24,0,22" />
          <StackPanel Orientation="Horizontal">
            <c:Icon Data="{StaticResource Icon.Globe}" Style="{StaticResource FactIcon}" />
            <TextBlock Text="{Binding S[setup.online.races_text]}" Style="{StaticResource Fact}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <c:Icon Data="{StaticResource Icon.Friends}" Style="{StaticResource FactIcon}" />
            <TextBlock Text="{Binding S[setup.online.friends_text]}" Style="{StaticResource Fact}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <c:Icon Data="{StaticResource Icon.Mic}" Style="{StaticResource FactIcon}" />
            <TextBlock Text="{Binding S[setup.online.voice_text]}" Style="{StaticResource Fact}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- the servers that announce themselves, nearest first; choosing one connects to it -->
      <StackPanel Visibility="{Binding Servers.HasList, Converter={StaticResource Conv.Visible}}">
        <Grid Margin="0,34,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:SectionHeader Text="{Binding S[settings.online.servers]}" Margin="0" ShowRule="False" VerticalAlignment="Center" />
          <c:ConsoleButton Grid.Column="1" Kind="Ghost" Height="68" MinWidth="0" Padding="22,0" Icon="{StaticResource Icon.Refresh}" Content="{Binding S[servers.refresh]}"
                           Command="{Binding Servers.RefreshCommand}" />
        </Grid>
        <settings:ServerList DataContext="{Binding Servers}" Margin="0,10,0,0" />
      </StackPanel>
      <c:SettingsRow Label="{Binding TypeAddressLabel}" Kind="Chevron" Icon="{StaticResource Icon.Globe}" Margin="0,12,0,0"
                     Command="{Binding ConnectCommand}" Caption="{Binding ConnectCaption}" />
      <TextBlock Text="{Binding S[settings.online.off_note]}" Style="{StaticResource Note}" />
      <TextBlock Text="{Binding BusyNote}" Style="{StaticResource Note}" Visibility="{Binding BusyNote, Converter={StaticResource Conv.Visible}}" />
    </StackPanel>

    <!-- ───────── online ───────── -->
    <StackPanel Visibility="{Binding OnlineEnabled, Converter={StaticResource Conv.Visible}}">
      <!-- the profile on this server, with its PIN -->
      <Border Style="{StaticResource Card}" Margin="0,24,0,0" DataContext="{Binding Profile}"
              Visibility="{Binding SignedIn, Converter={StaticResource Conv.Visible}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:Avatar DisplayName="{Binding SavedName}" Width="116" Height="116" />
          <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding SavedName}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding S[settings.profile.signed_in]}" Style="{StaticResource Text.Caption}" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,0,0">
            <TextBlock Text="{Binding S[settings.profile.pin]}" Style="{StaticResource Text.Small}" Margin="2,0,0,2" />
            <settings:PinField Pin="{Binding SavedPin}" IsRevealed="{Binding PinRevealed}" DigitSize="46" />
          </StackPanel>
        </Grid>
      </Border>

      <c:SectionHeader Text="{Binding S[settings.online.server]}" ShowRule="False" />
      <Border Style="{StaticResource Card}" Padding="28,22,22,22" Margin="0,4,0,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:Icon Data="{StaticResource Icon.Globe}" Width="48" Height="48" StrokeThickness="1.8" VerticalAlignment="Center" Margin="0,0,24,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding ServerShort}" Style="{StaticResource Text.Base}" FontSize="34" FontWeight="SemiBold" />
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="30" Height="32" VerticalAlignment="Top" Margin="0,0,6,0">
                <c:Spinner Width="24" Height="24" HorizontalAlignment="Left"
                           Visibility="{Binding ServerTone, Converter={StaticResource Conv.Visible}, ConverterParameter='=busy'}" />
                <Ellipse Width="16" Height="16" HorizontalAlignment="Left" Margin="2,0,0,0"
                         Visibility="{Binding ServerTone, Converter={StaticResource Conv.Visible}, ConverterParameter='!=busy'}">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{DynamicResource Brush.TextFaint}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ServerTone}" Value="good">
                          <Setter Property="Fill" Value="{DynamicResource Brush.Good}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ServerTone}" Value="bad">
                          <Setter Property="Fill" Value="{DynamicResource Brush.Bad}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
              </Grid>
              <TextBlock Grid.Column="1" Text="{Binding ServerSummary}" Style="{StaticResource Text.Caption}" FontSize="23" LineHeight="32" />
            </Grid>
          </StackPanel>
          <c:ConsoleButton Grid.Column="2" Kind="Danger" Height="72" MinWidth="0" Padding="28,0" FontSize="26" Margin="20,0,0,0" VerticalAlignment="Center"
                           Icon="{StaticResource Icon.SignalOff}" Content="{Binding S[settings.online.disconnect]}" Command="{Binding DisconnectCommand}" />
        </Grid>
      </Border>
      <!-- privacy, one row right under the server it is about: whether its policy is accepted (an icon and the word),
           and the way to the policy page, where it is read and accepted or withdrawn -->
      <c:SettingsRow Label="{Binding S[settings.privacy.policy]}" Kind="Chevron" Icon="{StaticResource Icon.Shield}"
                     Command="{Binding PrivacyCommand}" Caption="{Binding PrivacyCaption}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Visibility="{Binding PrivacyAccepted, Converter={StaticResource Conv.Visible}}">
            <c:Icon Data="{StaticResource Icon.Check}" Width="34" Height="34" StrokeThickness="2.6" Foreground="{DynamicResource Brush.Good}" Margin="0,0,10,0" />
            <TextBlock Text="{Binding S[settings.privacy.accepted]}" Foreground="{DynamicResource Brush.Good}" FontSize="28" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Visibility="{Binding PrivacyAccepted, Converter={StaticResource Conv.Visible}, ConverterParameter=!}">
            <c:Icon Data="{StaticResource Icon.Warning}" Width="34" Height="34" StrokeThickness="2.2" Foreground="{DynamicResource Brush.Warn}" Margin="0,0,10,0" />
            <TextBlock Text="{Binding S[settings.privacy.not_accepted]}" Foreground="{DynamicResource Brush.Warn}" FontSize="28" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </c:SettingsRow>
      <c:SettingsRow Label="{Binding S[settings.report.title]}" Kind="Chevron" Icon="{StaticResource Icon.Flag}"
                     Command="{Binding ReportCommand}" Caption="{Binding ReportCaption}" />
      <c:SettingsRow Label="{Binding S[settings.online.connect_other]}" Kind="Chevron" Icon="{StaticResource Icon.Signal}"
                     Command="{Binding ConnectCommand}" Caption="{Binding S[settings.online.change_caption]}" />
      <!-- no profile on this server yet (or another gamertag is being entered) -->
      <StackPanel DataContext="{Binding Profile}" Visibility="{Binding ShowEntry, Converter={StaticResource Conv.Visible}}">
        <c:SectionHeader Text="{Binding S[settings.online.register]}" />
        <settings:ProfileEntry Margin="0,26,0,0" />
        <c:SettingsRow Label="{Binding S[settings.profile.keep]}" Value="{Binding SavedName}" Kind="Chevron" Margin="0,26,0,0"
                       Command="{Binding CancelEditCommand}" Caption="{Binding S[settings.profile.keep_caption]}"
                       Visibility="{Binding Editing, Converter={StaticResource Conv.Visible}}" />
      </StackPanel>
      <StackPanel DataContext="{Binding Profile}" Visibility="{Binding SignedIn, Converter={StaticResource Conv.Visible}}">
        <c:SectionHeader Text="{Binding S[settings.online.profile]}" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Note}" />
        <c:SettingsRow Label="{Binding S[settings.profile.change]}" Kind="Chevron" Icon="{StaticResource Icon.User}" Margin="0,8,0,0"
                       Command="{Binding EditCommand}" Caption="{Binding S[settings.profile.change_caption]}" />
      </StackPanel>

      <StackPanel DataContext="{Binding Profile}" Visibility="{Binding SignedIn, Converter={StaticResource Conv.Visible}}">
        <c:SectionHeader Text="{Binding S[settings.profile.delete_section]}" />
        <c:SettingsRow Label="{Binding S[settings.profile.delete]}" Icon="{StaticResource Icon.Trash}" IsDestructive="True"
                       Command="{Binding DeleteCommand}" Caption="{Binding S[settings.privacy.delete_caption]}" />
      </StackPanel>
      <TextBlock Text="{Binding BusyNote}" Style="{StaticResource Note}" Visibility="{Binding BusyNote, Converter={StaticResource Conv.Visible}}" />
    </StackPanel>
  </Grid>

  <!-- ───────── where the server list comes from (both states of an MKWMP server; not on Nextendo Network) ───────── -->
  <StackPanel Visibility="{Binding ShowMkwmpOnline, Converter={StaticResource Conv.Visible}}">
  <c:SectionHeader Text="{Binding S[settings.online.announcer]}" />
  <Grid Margin="0,22,0,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBox Text="{Binding AnnouncerAddress, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Height="76" FontSize="28"
             VerticalContentAlignment="Center" IsEnabled="{Binding NotBusy}" />
    <c:ConsoleButton Grid.Column="1" Content="{Binding S[settings.online.announcer_save]}" Command="{Binding SaveAnnouncerCommand}"
                     Height="76" MinWidth="0" Padding="30,0" Margin="16,0,0,0" />
  </Grid>
  <TextBlock Text="{Binding AnnouncerNote}">
    <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding AnnouncerNoteIsError}" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </TextBlock.Style>
  </TextBlock>
  <c:SettingsRow Label="{Binding S[settings.online.announcer_reset]}" Icon="{StaticResource Icon.Refresh}" Margin="0,14,0,0"
                 Command="{Binding DefaultAnnouncerCommand}" Caption="{Binding S[settings.online.announcer_reset_caption]}"
                 Visibility="{Binding AnnouncerCustom, Converter={StaticResource Conv.Visible}}" />
  <!-- the servers taken out of the list on this PC (Y on a row), each with "Show again" -->
  <c:SettingsRow Label="{Binding HiddenServersLabel}" Kind="Chevron" Icon="{StaticResource Icon.EyeOff}" Margin="0,14,0,0"
                 Command="{Binding HiddenServersCommand}" Caption="{Binding S[servers.hidden.caption]}"
                 Visibility="{Binding HasHiddenServers, Converter={StaticResource Conv.Visible}}" />
  </StackPanel>
  </StackPanel>
</UserControl>
