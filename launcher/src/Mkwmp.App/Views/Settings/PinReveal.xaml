<UserControl x:Class="Mkwmp.App.Views.Settings.PinReveal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:settings="clr-namespace:Mkwmp.App.Views.Settings"
             Focusable="False">
  <!-- DataContext: PinRevealViewModel. The PIN, large, in a modal (right after REGISTER; before a delete):
       dots until the eye (or X) shows it. -->
  <Border Background="{DynamicResource Brush.Surface}" CornerRadius="14" Padding="40,26,40,30" Margin="0,8,0,0">
    <StackPanel HorizontalAlignment="Center">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <c:Icon Data="{StaticResource Icon.Lock}" Width="34" Height="34" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,12,0" />
        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}" FontSize="27" />
      </StackPanel>
      <settings:PinField Pin="{Binding Pin}" IsRevealed="{Binding IsRevealed}" DigitSize="96" Margin="114,6,0,0" />
    </StackPanel>
  </Border>
</UserControl>
