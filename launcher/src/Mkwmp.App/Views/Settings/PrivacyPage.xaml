<UserControl x:Class="Mkwmp.App.Views.Settings.PrivacyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:settings="clr-namespace:Mkwmp.App.Views.Settings"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             Focusable="False">
  <!-- DataContext: PrivacyViewModel. The privacy policy as the launcher renders it (MarkdownView): each
       section a card the D-pad stops on, so the page scrolls with a controller; links are rows. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <c:PageHeader Title="{Binding S[settings.privacy.policy]}" Icon="{StaticResource Icon.Shield}">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Small}" FontSize="23" HorizontalAlignment="Right" />
        <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Small}" FontSize="19" HorizontalAlignment="Right"
                   Visibility="{Binding Version, Converter={StaticResource Conv.Visible}}" />
      </StackPanel>
    </c:PageHeader>
    <c:Spinner Grid.Row="1" Width="72" Height="72" Visibility="{Binding Loading, Converter={StaticResource Conv.Visible}}" />
    <c:SmoothScrollViewer Grid.Row="1" Padding="16,26,24,60" EdgePadding="110" input:FocusNav.IsGroup="True" HorizontalAlignment="Center" Width="1300"
                          Visibility="{Binding Loading, Converter={StaticResource Conv.Visible}, ConverterParameter=!}">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding Note, Converter={StaticResource Conv.Visible}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:Icon Data="{StaticResource Icon.Info}" Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,20,0" Foreground="{DynamicResource Brush.Warn}" />
            <TextBlock Grid.Column="1" Text="{Binding Note}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text}" />
          </Grid>
        </Border>
        <settings:MarkdownView Markdown="{Binding Markdown}" LinkCommand="{Binding LinkCommand}" />
      </StackPanel>
    </c:SmoothScrollViewer>
  </Grid>
</UserControl>
