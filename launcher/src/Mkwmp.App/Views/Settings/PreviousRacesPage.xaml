<UserControl x:Class="Mkwmp.App.Views.Settings.PreviousRacesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             x:Name="Self" Focusable="False">
  <!-- DataContext: PreviousRacesViewModel. Previous Races: the online sessions kept on this PC, newest first (when, the
       network, how many races and players; in the warning colour, how many players changed names). A on one opens it.
       Under the list, "Clear History" (after a confirmation). -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <c:PageHeader Title="{Binding S[races.title]}" Icon="{StaticResource Icon.Clock}" />
    <c:SmoothScrollViewer Grid.Row="1" Padding="16,26,24,60" EdgePadding="110" input:FocusNav.IsGroup="True" HorizontalAlignment="Center" Width="1300">
      <StackPanel>
        <TextBlock Text="{Binding S[races.caption]}" Style="{StaticResource Text.Caption}" Margin="20,0,20,18" />
        <c:Spinner Width="56" Height="56" Margin="0,40,0,0" Visibility="{Binding Loading, Converter={StaticResource Conv.Visible}}" />
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource CardButton}" Background="Transparent" Padding="20,16" Margin="0,2" Command="{Binding OpenCommand}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <c:Icon Data="{StaticResource Icon.Trophy}" Width="44" Height="44" StrokeThickness="1.8" VerticalAlignment="Center" Margin="0,0,24,0" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Base}" FontSize="32" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" FontSize="23" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                              Visibility="{Binding Flag, Converter={StaticResource Conv.Visible}}">
                    <c:Icon Data="{StaticResource Icon.Warning}" Width="30" Height="30" StrokeThickness="2.2" Foreground="{DynamicResource Brush.Warn}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Flag}" Foreground="{DynamicResource Brush.Warn}" Style="{StaticResource Text.Base}" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                  <c:Icon Grid.Column="3" Data="{StaticResource Icon.ChevronRight}" Width="30" Height="30" Margin="18,0,0,0" VerticalAlignment="Center"
                          Foreground="{DynamicResource Brush.TextMuted}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding S[races.empty]}" Style="{StaticResource Text.Caption}" Margin="20,26,20,0"
                   Visibility="{Binding IsEmpty, Converter={StaticResource Conv.Visible}}" />
        <c:SettingsRow Label="{Binding S[races.clear]}" Icon="{StaticResource Icon.Trash}" IsDestructive="True" Margin="0,30,0,0"
                       Command="{Binding ClearCommand}" Caption="{Binding S[races.clear.caption]}"
                       Visibility="{Binding HasRows, Converter={StaticResource Conv.Visible}}" />
      </StackPanel>
    </c:SmoothScrollViewer>
  </Grid>
</UserControl>
