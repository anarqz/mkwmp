<UserControl x:Class="Mkwmp.App.Views.Settings.NextendoFacts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             Focusable="False">
  <!-- DataContext: SettingsViewModel (SettingsViewModel.Nextendo.cs). The linked Nextendo account's two facts, the same
       in Settings › Nextendo and in Settings › Online while PLAY goes there: its friend code, and how it stands on
       Nextendo (a light, and under the label what Nextendo said: ready, or why it may not go online). -->
  <StackPanel>
    <c:SettingsRow Label="{Binding S[nextendo.friend_code]}" Kind="Value" Value="{Binding NextendoFriendCode}" Focusable="False"
                   Visibility="{Binding HasNextendoFriendCode, Converter={StaticResource Conv.Visible}}" />
    <c:SettingsRow Label="{Binding S[nextendo.status]}" Caption="{Binding NextendoStatus}" Focusable="False">
      <Grid Width="40" Height="40" VerticalAlignment="Center">
        <c:Spinner Width="30" Height="30"
                   Visibility="{Binding NextendoTone, Converter={StaticResource Conv.Visible}, ConverterParameter='=busy'}" />
        <Ellipse Width="18" Height="18"
                 Visibility="{Binding NextendoTone, Converter={StaticResource Conv.Visible}, ConverterParameter='!=busy'}">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{DynamicResource Brush.TextFaint}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding NextendoTone}" Value="good">
                  <Setter Property="Fill" Value="{DynamicResource Brush.Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NextendoTone}" Value="warn">
                  <Setter Property="Fill" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NextendoTone}" Value="bad">
                  <Setter Property="Fill" Value="{DynamicResource Brush.Bad}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
      </Grid>
    </c:SettingsRow>
  </StackPanel>
</UserControl>
