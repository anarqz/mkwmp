<UserControl x:Class="Mkwmp.App.Views.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             Focusable="False">
  <!-- DataContext: SettingsViewModel. STUB that shows the settings layout of the design system:
       PageHeader, CategoryList at the left, a pane of SectionHeader + SettingsRow at the right. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <c:PageHeader Title="{Binding S[settings.title]}" Icon="{StaticResource Icon.Settings}" />

    <Grid Grid.Row="1" Margin="{StaticResource Metric.PageMargin}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="560" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <c:CategoryList ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" Margin="20,0,0,0" />
      <Border Grid.Column="1" Width="1.5" Margin="0,22,0,0" Background="{DynamicResource Brush.Rule}" />

      <c:SmoothScrollViewer Grid.Column="2" Padding="62,0,60,40" input:FocusNav.IsGroup="True">
        <Grid>

          <!-- Appearance (real) -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=appearance'}">
            <c:SectionHeader Text="{Binding S[settings.appearance.look]}" />
            <c:SettingsRow Label="{Binding S[settings.theme]}" Kind="Value" Value="{Binding ThemeName}" Command="{Binding ThemeCommand}" />
            <c:SettingsRow Label="{Binding S[settings.fullscreen]}" Kind="Toggle" IsOn="{Binding Fullscreen}"
                           Caption="{Binding S[settings.fullscreen.caption]}" />
            <c:SectionHeader Text="{Binding S[settings.appearance.language]}" />
            <c:SettingsRow Label="{Binding S[settings.language]}" Kind="Chevron" Value="{Binding S[settings.language.name]}" IsEnabled="False" />
          </StackPanel>

          <!-- About (real) -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=about'}">
            <Border Style="{StaticResource Card}" Margin="0,38,0,0">
              <StackPanel>
                <TextBlock Text="{Binding Shell.AboutTitle}" Style="{StaticResource Text.Heading}" />
                <TextBlock Text="{Binding Shell.AboutBasedOn, Mode=OneWay}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                <TextBlock Text="{Binding Shell.AboutLicense, Mode=OneWay}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <c:SectionHeader Text="{Binding S[settings.about.tools]}" />
            <c:SettingsRow Label="{Binding S[settings.about.toast]}" Command="{Binding TestToastCommand}" />
          </StackPanel>

          <!-- Updates -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=updates'}">
            <c:SectionHeader Text="{Binding S[settings.updates]}" />
            <c:SettingsRow Label="{Binding S[settings.updates.check]}" Kind="Chevron" Command="{Binding UpdateCommand}"
                           Caption="{Binding UpdateSummary}" />
          </StackPanel>

          <!-- Game (placeholder with live values) -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=game'}">
            <c:SectionHeader Text="{Binding S[settings.game]}" />
            <c:SettingsRow Label="{Binding S[settings.game.install]}" Kind="Chevron" Value="{Binding GameSummary}" />
            <c:SettingsRow Label="{Binding S[settings.game.integration]}" Kind="Value" Value="{Binding IntegrationSummary}" />
          </StackPanel>

          <!-- Party Chat (placeholder) -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=chat'}">
            <c:SectionHeader Text="{Binding S[settings.chat.output]}" />
            <c:SettingsRow Label="{Binding S[settings.chat.device]}" Kind="Value" Value="{Binding S[settings.automatic]}" />
            <c:ConsoleSlider Label="{Binding S[settings.chat.volume]}" Value="{Binding OutputGain, Mode=TwoWay}" Maximum="200" />
          </StackPanel>

          <!-- Notifications (placeholder) -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=notifications'}">
            <c:SectionHeader Text="{Binding S[settings.notifications]}" />
            <c:SettingsRow Label="{Binding S[settings.notifications.online]}" Kind="Toggle" IsOn="{Binding NotifyOnline}" />
          </StackPanel>

          <!-- Profile (placeholder) -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=profile'}">
            <Border Style="{StaticResource Card}" Margin="0,38,0,0">
              <StackPanel Orientation="Horizontal">
                <c:Avatar DisplayName="{Binding Shell.Profile.Name}" Width="110" Height="110" />
                <StackPanel Margin="28,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Shell.Profile.Name}" Style="{StaticResource Text.Heading}" />
                  <TextBlock Text="{Binding S[settings.profile.signed_in]}" Style="{StaticResource Text.Caption}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </c:SmoothScrollViewer>
    </Grid>
  </Grid>
</UserControl>
