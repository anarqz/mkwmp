<UserControl x:Class="Mkwmp.App.Views.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             xmlns:settings="clr-namespace:Mkwmp.App.Views.Settings"
             Focusable="False">
  <!-- DataContext: SettingsViewModel. PageHeader, the CategoryList at the left, the chosen category's
       pane at the right (SectionHeader + SettingsRow; text boxes in "Field" rows). -->
  <UserControl.Resources>
    <!-- a row that holds a label and a text box -->
    <Style x:Key="Field" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}" />
      <Setter Property="BorderThickness" Value="0,0,0,1.5" />
      <Setter Property="Padding" Value="20,14,20,14" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
      <Setter Property="FontSize" Value="32" />
      <Setter Property="Margin" Value="0,0,28,0" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
      <Setter Property="Margin" Value="28,0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- a paragraph under a group of rows -->
    <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="Margin" Value="20,16,20,0" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <c:PageHeader Title="{Binding S[settings.title]}" Icon="{StaticResource Icon.Settings}" />

    <Grid Grid.Row="1" Margin="{StaticResource Metric.PageMargin}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="520" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <c:CategoryList ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" Margin="20,0,0,0"
                      input:FocusNav.IsColumn="True" />
      <Border Grid.Column="1" Width="1.5" Margin="0,22,0,0" Background="{DynamicResource Brush.Rule}" />

      <c:SmoothScrollViewer Grid.Column="2" Padding="62,0,60,60" EdgePadding="90" input:FocusNav.IsGroup="True" input:FocusNav.IsColumn="True">
        <Grid>

          <!-- ═════════ Profile ═════════ -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=profile'}">
            <StackPanel DataContext="{Binding Profile}" Visibility="{Binding SignedIn, Converter={StaticResource Conv.Visible}}">
              <Border Style="{StaticResource Card}" Margin="0,38,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <c:Avatar DisplayName="{Binding SavedName}" Width="116" Height="116" />
                  <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SavedName}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{Binding S[settings.profile.signed_in]}" Style="{StaticResource Text.Caption}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,8,0">
                    <TextBlock Text="{Binding S[settings.profile.pin]}" Style="{StaticResource Text.Small}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding SavedPin}" Style="{StaticResource Text.Value}" FontSize="46" FontWeight="ExtraBold" HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </Border>
              <c:SectionHeader Text="{Binding S[settings.profile.gamertag]}" />
              <c:SettingsRow Label="{Binding S[settings.profile.show_pin]}" Kind="Chevron" Icon="{StaticResource Icon.Lock}"
                             Command="{Binding ShowPinCommand}" Caption="{Binding Message}" />
              <c:SettingsRow Label="{Binding S[settings.profile.change]}" Kind="Chevron" Icon="{StaticResource Icon.User}"
                             Command="{Binding EditCommand}" Caption="{Binding S[settings.profile.change_caption]}" />
              <c:SectionHeader Text="{Binding S[settings.profile.delete_section]}" />
              <c:SettingsRow Label="{Binding S[settings.profile.delete]}" Icon="{StaticResource Icon.Trash}"
                             Command="{Binding DeleteCommand}" Caption="{Binding S[settings.profile.delete_caption]}" />
              <TextBlock Text="{Binding BusyNote}" Style="{StaticResource Note}"
                         Visibility="{Binding BusyNote, Converter={StaticResource Conv.Visible}}" />
            </StackPanel>

            <StackPanel DataContext="{Binding Profile}" Visibility="{Binding ShowEntry, Converter={StaticResource Conv.Visible}}">
              <c:SectionHeader Text="{Binding S[settings.profile.gamertag]}" />
              <settings:ProfileEntry Margin="0,26,0,0" />
              <c:SettingsRow Label="{Binding S[settings.profile.keep]}" Value="{Binding SavedName}" Kind="Chevron" Margin="0,26,0,0"
                             Command="{Binding CancelEditCommand}" Caption="{Binding S[settings.profile.keep_caption]}"
                             Visibility="{Binding Editing, Converter={StaticResource Conv.Visible}}" />
            </StackPanel>
          </StackPanel>

          <!-- ═════════ Game ═════════ -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=game'}">
            <c:SectionHeader Text="{Binding S[settings.game]}" />
            <c:SettingsRow Label="{Binding S[settings.game.target]}" Kind="Chevron" Icon="{StaticResource Icon.Kart}"
                           Value="{Binding Game.TargetName}" Command="{Binding Game.TargetCommand}" />
            <settings:GamePanel DataContext="{Binding Game}" />

            <c:SectionHeader Text="{Binding S[settings.game.files]}" />
            <TextBlock Text="{Binding S[settings.game.files_caption]}" Style="{StaticResource Note}" />
            <ItemsControl ItemsSource="{Binding Game.Files}" Focusable="False" Margin="66,10,20,0"
                          Visibility="{Binding Game.HasFiles, Converter={StaticResource Conv.Visible}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" FontSize="23" LineHeight="33" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <c:SettingsRow Label="{Binding Game.InstallLabel}" Icon="{StaticResource Icon.Download}" Margin="0,10,0,0"
                           Command="{Binding Game.InstallCommand}" Caption="{Binding S[settings.game.install_caption]}" />
            <c:SettingsRow Label="{Binding S[settings.game.uninstall]}" Icon="{StaticResource Icon.Trash}"
                           Command="{Binding Game.UninstallCommand}" Caption="{Binding S[settings.game.uninstall_caption]}" />
            <TextBlock Text="{Binding Game.Note}" Margin="20,10,20,0"
                       Visibility="{Binding Game.Note, Converter={StaticResource Conv.Visible}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Good}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Game.NoteIsError}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Game.Working}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <StackPanel Visibility="{Binding NoGameSettingsNote, Converter={StaticResource Conv.Visible}}">
              <c:SectionHeader Text="{Binding S[settings.gs.heading]}" />
              <TextBlock Text="{Binding NoGameSettingsNote}" Style="{StaticResource Note}" />
            </StackPanel>

            <c:SectionHeader Text="{Binding S[settings.game.start]}" />
            <c:SettingsRow Label="{Binding S[settings.game.steam]}" Kind="Toggle" IsOn="{Binding Game.FromSteam}"
                           IsEnabled="{Binding Game.CanChange}" Caption="{Binding S[settings.game.steam_caption]}" />
            <c:SettingsRow Label="{Binding S[settings.game.seat]}" Kind="Chevron" Value="{Binding SeatName}" Command="{Binding SeatCommand}"
                           Caption="{Binding S[settings.game.seat_body]}" />

            <c:SectionHeader Text="{Binding S[settings.game.advanced]}" />
            <Border Style="{StaticResource Field}">
              <StackPanel>
                <TextBlock Text="{Binding S[settings.game.typed]}" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                <Grid>
                  <TextBox x:Name="TypedFolder" Text="{Binding Game.TypedFolder, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding Game.CanChange}" />
                  <TextBlock Text="{Binding S[settings.game.typed_hint]}" Style="{StaticResource Hint}"
                             Visibility="{Binding Text, ElementName=TypedFolder, Converter={StaticResource Conv.Visible}, ConverterParameter=!}" />
                </Grid>
                <TextBlock Text="{Binding Game.TypedFolderCaption}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Field}">
              <StackPanel>
                <TextBlock Text="{Binding S[settings.game.command]}" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                <Grid>
                  <TextBox x:Name="LaunchBox" Text="{Binding LaunchCommandText, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding NotBusy}" />
                  <TextBlock Text="{Binding S[settings.game.command_hint]}" Style="{StaticResource Hint}"
                             Visibility="{Binding Text, ElementName=LaunchBox, Converter={StaticResource Conv.Visible}, ConverterParameter=!}" />
                </Grid>
                <TextBlock Text="{Binding S[settings.game.command_caption]}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Field}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding S[settings.game.port]}" Style="{StaticResource FieldLabel}" />
                  <TextBox Grid.Column="1" Text="{Binding LocalPortText, UpdateSourceTrigger=LostFocus}" MaxLength="5" IsEnabled="{Binding NotBusy}"
                           TextAlignment="Right" InputScope="Number" />
                </Grid>
                <TextBlock Text="{Binding S[settings.game.port_caption]}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding BusyNote}" Style="{StaticResource Note}" Visibility="{Binding BusyNote, Converter={StaticResource Conv.Visible}}" />
          </StackPanel>

          <!-- ═════════ The game's own settings: rows from the target's schema ═════════ -->
          <StackPanel x:Name="GameSettingsPane" Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=gs'}">
            <c:SectionHeader Text="{Binding GameCategoryTitle}" />
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding GameSettingsNote, Converter={StaticResource Conv.Visible}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:Icon Data="{StaticResource Icon.Info}" Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,20,0">
                  <c:Icon.Style>
                    <Style TargetType="c:Icon">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding GameSettingsNoteIsError}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </c:Icon.Style>
                </c:Icon>
                <TextBlock Grid.Column="1" Text="{Binding GameSettingsNote}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding GameSettingsNoteIsError}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding GameAdvancedNote, Converter={StaticResource Conv.Visible}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:Icon Data="{StaticResource Icon.Warning}" Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,20,0"
                        Foreground="{DynamicResource Brush.Warn}" />
                <TextBlock Grid.Column="1" Text="{Binding GameAdvancedNote}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text}" />
              </Grid>
            </Border>
            <TextBlock Text="{Binding GamePlainNote}" Style="{StaticResource Note}" Visibility="{Binding GamePlainNote, Converter={StaticResource Conv.Visible}}" />
            <TextBlock Text="{Binding GameSchemaNote}" Style="{StaticResource Note}" Visibility="{Binding GameSchemaNote, Converter={StaticResource Conv.Visible}}" />

            <ItemsControl ItemsSource="{Binding GameRows}" Focusable="False" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Visibility="{Binding Visible, Converter={StaticResource Conv.Visible}}">
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Base}" FontSize="25" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="20,34,20,6"
                               Visibility="{Binding Heading, Converter={StaticResource Conv.Visible}}" />
                    <Grid>
                      <c:SettingsRow Label="{Binding Label}" Kind="Toggle" IsOn="{Binding IsOn}" IsEnabled="{Binding Enabled}" Caption="{Binding Caption}"
                                     Visibility="{Binding IsToggle, Converter={StaticResource Conv.Visible}}" />
                      <c:SettingsRow Label="{Binding Label}" Kind="Chevron" Value="{Binding ChoiceText}" Command="{Binding PickCommand}" Caption="{Binding Caption}"
                                     Visibility="{Binding IsChoice, Converter={StaticResource Conv.Visible}}" />
                      <StackPanel Visibility="{Binding IsRange, Converter={StaticResource Conv.Visible}}">
                        <c:ConsoleSlider Label="{Binding Label}" Value="{Binding Number, Mode=TwoWay}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                         SmallChange="{Binding Step}" LargeChange="{Binding Step}" DisplayText="{Binding NumberText}"
                                         IsEnabled="{Binding Enabled}" />
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Caption}" Margin="20,14,20,20"
                                   Visibility="{Binding Caption, Converter={StaticResource Conv.Visible}}" />
                      </StackPanel>
                      <Border Style="{StaticResource Field}" Visibility="{Binding IsText, Converter={StaticResource Conv.Visible}}">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" MaxLength="{Binding MaxLength}"
                                     IsEnabled="{Binding Enabled}" />
                          </Grid>
                          <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Caption}" Margin="0,12,0,4"
                                     Visibility="{Binding Caption, Converter={StaticResource Conv.Visible}}" />
                        </StackPanel>
                      </Border>
                      <!-- the mark of a setting that is not at its default -->
                      <Ellipse Width="10" Height="10" Fill="{DynamicResource Brush.Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="2,47,0,0" IsHitTestVisible="False"
                               Visibility="{Binding IsChanged, Converter={StaticResource Conv.Visible}}" />
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Visibility="{Binding HasGameRows, Converter={StaticResource Conv.Visible}}">
              <TextBlock Text="{Binding S[settings.gs.legend]}" Style="{StaticResource Note}" Margin="20,26,20,0" />
              <c:SettingsRow Label="{Binding S[settings.gs.reset_all]}" Icon="{StaticResource Icon.Refresh}" Command="{Binding ResetGameSettingsCommand}"
                             Caption="{Binding S[settings.gs.reset_all_caption]}" Margin="0,8,0,0" />
            </StackPanel>
          </StackPanel>

          <!-- ═════════ Party Chat ═════════ -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=chat'}">
            <c:SectionHeader Text="{Binding S[settings.chat.voice]}" />
            <c:SettingsRow Label="{Binding S[settings.chat.enabled]}" Kind="Toggle" IsOn="{Binding VoiceEnabled}"
                           Caption="{Binding S[settings.chat.enabled_caption]}" />
            <c:SettingsRow Label="{Binding S[settings.chat.input]}" Kind="Chevron" Icon="{StaticResource Icon.Mic}"
                           Value="{Binding InputName}" Command="{Binding InputCommand}" />
            <c:SettingsRow Label="{Binding S[settings.chat.output]}" Kind="Chevron" Icon="{StaticResource Icon.Headset}"
                           Value="{Binding OutputName}" Command="{Binding OutputCommand}" Caption="{Binding DevicesCaption}" />
            <c:ConsoleSlider Label="{Binding S[settings.chat.mic_volume]}" Value="{Binding InputGain, Mode=TwoWay}" Minimum="1" Maximum="100"
                             IsEnabled="{Binding VoiceEnabled}" />
            <c:ConsoleSlider Label="{Binding S[settings.chat.volume]}" Value="{Binding OutputGain, Mode=TwoWay}" Minimum="1" Maximum="100"
                             IsEnabled="{Binding VoiceEnabled}" />

            <c:SectionHeader Text="{Binding S[settings.chat.tests]}" />
            <c:SettingsRow Label="{Binding S[settings.chat.mic_test]}" Kind="Toggle" IsOn="{Binding MicTesting}"
                           Caption="{Binding S[settings.chat.mic_test_caption]}">
              <Grid Width="300" Height="16" Margin="0,0,30,0" Visibility="{Binding MicTesting, Converter={StaticResource Conv.Visible}}">
                <Border x:Name="MeterTrack" CornerRadius="8" Background="{DynamicResource Brush.Track}" />
                <Border CornerRadius="8" Background="{DynamicResource Brush.Good}" HorizontalAlignment="Left">
                  <Border.Width>
                    <MultiBinding Converter="{StaticResource Conv.Fraction}">
                      <Binding Path="Mic.Level" />
                      <Binding Path="ActualWidth" ElementName="MeterTrack" />
                    </MultiBinding>
                  </Border.Width>
                </Border>
              </Grid>
            </c:SettingsRow>
            <c:SettingsRow Label="{Binding S[settings.chat.hear]}" Kind="Toggle" IsOn="{Binding HearMyself}"
                           Caption="{Binding S[settings.chat.hear_caption]}"
                           Visibility="{Binding MicTesting, Converter={StaticResource Conv.Visible}}" />
            <c:SettingsRow Label="{Binding S[settings.chat.output_test]}" Icon="{StaticResource Icon.Volume}" Command="{Binding TestOutputCommand}"
                           Caption="{Binding S[settings.chat.output_test_caption]}" />

            <c:SectionHeader Text="{Binding S[settings.chat.camera]}" />
            <c:SettingsRow Label="{Binding S[settings.chat.camera_device]}" Kind="Chevron" Icon="{StaticResource Icon.Camera}"
                           Value="{Binding CameraName}" Command="{Binding CameraCommand}" />
            <c:SettingsRow Label="{Binding S[settings.chat.mirror]}" Kind="Toggle" IsOn="{Binding CameraMirror}"
                           IsEnabled="{Binding CameraTestAvailable}" />
            <c:SettingsRow Label="{Binding S[settings.chat.camera_test]}" Kind="Chevron" Command="{Binding TestCameraCommand}"
                           Caption="{Binding S[settings.chat.camera_test_caption]}" />
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding CameraNote, Converter={StaticResource Conv.Visible}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:Icon Data="{StaticResource Icon.Info}" Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,20,0"
                        Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBlock Grid.Column="1" Text="{Binding CameraNote}" Style="{StaticResource Text.Caption}" />
              </Grid>
            </Border>

            <StackPanel Visibility="{Binding HasGameCamera, Converter={StaticResource Conv.Visible}}">
              <c:SectionHeader Text="{Binding S[settings.chat.game_camera]}" />
              <c:SettingsRow Label="{Binding S[settings.chat.show_mine]}" Kind="Toggle" IsOn="{Binding ShowMyCamera}"
                             IsEnabled="{Binding CanShowMyCamera}" />
              <c:SettingsRow Label="{Binding S[settings.chat.see_friends]}" Kind="Toggle" IsOn="{Binding SeeFriendsCameras}"
                             IsEnabled="{Binding CanChangeGameCamera}" />
              <TextBlock Text="{Binding GameCameraCaption}" Style="{StaticResource Note}" />
            </StackPanel>

            <c:SectionHeader Text="{Binding S[settings.chat.muted]}" />
            <TextBlock Text="{Binding S[settings.chat.muted_none]}" Style="{StaticResource Note}"
                       Visibility="{Binding NoMutes, Converter={StaticResource Conv.Visible}}" />
            <ItemsControl ItemsSource="{Binding Mutes}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Field}" Padding="20,10,10,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <c:Avatar DisplayName="{Binding Name}" Width="64" Height="64" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Base}" FontSize="32" Margin="22,0" />
                      <c:ConsoleButton Grid.Column="2" MinWidth="210" Height="78" Padding="26,0" Content="{Binding DataContext.S[settings.chat.unmute], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       Command="{Binding UnmuteCommand}" />
                      <c:ConsoleButton Grid.Column="3" Kind="Secondary" MinWidth="210" Height="78" Padding="26,0" Margin="14,0,0,0"
                                       Icon="{StaticResource Icon.Flag}"
                                       Content="{Binding DataContext.S[settings.chat.report], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       Command="{Binding ReportCommand}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <c:SectionHeader Text="{Binding S[settings.report.title]}" />
            <TextBlock Text="{Binding S[settings.report.gate]}" Style="{StaticResource Note}"
                       Visibility="{Binding ReportState, Converter={StaticResource Conv.Visible}, ConverterParameter='=gate'}" />
            <TextBlock Text="{Binding ReportChecking}" Style="{StaticResource Note}"
                       Visibility="{Binding ReportState, Converter={StaticResource Conv.Visible}, ConverterParameter='=checking'}" />
            <StackPanel Visibility="{Binding ReportState, Converter={StaticResource Conv.Visible}, ConverterParameter='=open'}">
              <TextBlock Text="{Binding OpenReportText}" Style="{StaticResource Text.Body}" Margin="20,18,20,0" />
              <c:SettingsRow Label="{Binding S[settings.report.withdraw]}" Icon="{StaticResource Icon.Close}" Command="{Binding WithdrawReportCommand}"
                             Caption="{Binding S[settings.report.one]}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Visibility="{Binding ReportState, Converter={StaticResource Conv.Visible}, ConverterParameter='=form'}">
              <Border Style="{StaticResource Field}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding S[settings.profile.gamertag]}" Style="{StaticResource FieldLabel}" />
                  <Grid Grid.Column="1">
                    <TextBox x:Name="ReportNameBox" Text="{Binding ReportName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" />
                    <TextBlock Text="{Binding S[settings.report.name_hint]}" Style="{StaticResource Hint}" FontSize="25"
                               Visibility="{Binding Text, ElementName=ReportNameBox, Converter={StaticResource Conv.Visible}, ConverterParameter=!}" />
                  </Grid>
                </Grid>
              </Border>
              <c:SettingsRow Label="{Binding S[settings.report.what]}" Kind="Chevron" Value="{Binding ReportReasonName}" Command="{Binding ReasonCommand}" />
              <Border Style="{StaticResource Field}">
                <Grid>
                  <TextBox x:Name="ReportDetailsBox" Text="{Binding ReportDetails, UpdateSourceTrigger=PropertyChanged}" Height="170"
                           MaxLength="{Binding ReportDetailsMax, Mode=OneTime}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding S[settings.report.details_hint]}" Style="{StaticResource Hint}" FontSize="25"
                             Visibility="{Binding Text, ElementName=ReportDetailsBox, Converter={StaticResource Conv.Visible}, ConverterParameter=!}" />
                </Grid>
              </Border>
              <c:SettingsRow Label="{Binding S[settings.report.send]}" Icon="{StaticResource Icon.Flag}" Command="{Binding SendReportCommand}"
                             Caption="{Binding S[settings.report.caption]}" />
            </StackPanel>
            <TextBlock Text="{Binding ReportNote}" Margin="20,10,20,0" Visibility="{Binding ReportNote, Converter={StaticResource Conv.Visible}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Good}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ReportNoteIsError}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <c:SectionHeader Text="{Binding S[settings.chat.about]}" />
            <c:SettingsRow Label="{Binding S[settings.chat.replay]}" Kind="Chevron" Command="{Binding ReplayIntroCommand}" />
          </StackPanel>

          <!-- ═════════ Notifications and background ═════════ -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=notifications'}">
            <c:SectionHeader Text="{Binding S[settings.notify.when]}" />
            <c:SettingsRow Label="{Binding S[settings.notify.online]}" Kind="Toggle" IsOn="{Binding NotifyOnline}" />
            <c:SettingsRow Label="{Binding S[settings.notify.playing]}" Kind="Toggle" IsOn="{Binding NotifyPlaying}" />
            <c:SettingsRow Label="{Binding S[settings.notify.requests]}" Kind="Toggle" IsOn="{Binding NotifyRequests}" />
            <c:SettingsRow Label="{Binding S[settings.notify.test]}" Icon="{StaticResource Icon.Bell}" Command="{Binding TestToastCommand}"
                           Caption="{Binding S[settings.notify.test_caption]}" />

            <c:SectionHeader Text="{Binding S[settings.background]}" />
            <c:SettingsRow Label="{Binding S[settings.background.tray]}" Kind="Toggle" IsOn="{Binding CloseToTray}" IsEnabled="{Binding HasTray}"
                           Caption="{Binding S[settings.background.tray_caption]}" />
            <c:SettingsRow Label="{Binding S[settings.background.autostart]}" Kind="Toggle" IsOn="{Binding StartWithSystem}"
                           Visibility="{Binding CanStartWithSystem, Converter={StaticResource Conv.Visible}}" />
            <TextBlock Text="{Binding TrayCaption}" Style="{StaticResource Note}" />
            <TextBlock Text="{Binding S[settings.background.autostart_linux]}" Style="{StaticResource Note}"
                       Visibility="{Binding IsWine, Converter={StaticResource Conv.Visible}}" />
          </StackPanel>

          <!-- ═════════ Privacy ═════════ -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=privacy'}">
            <c:SectionHeader Text="{Binding S[setup.consent.title]}" />
            <Border Style="{StaticResource Card}" Margin="0,18,0,6">
              <StackPanel>
                <TextBlock Text="{Binding S[setup.consent.p1]}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Text="{Binding S[setup.consent.p2]}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                <TextBlock Text="{Binding S[setup.consent.p3]}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <c:SettingsRow Label="{Binding S[setup.consent.adult]}" Kind="Toggle" IsOn="{Binding Adult}" IsEnabled="{Binding NotBusy}"
                           Caption="{Binding S[settings.privacy.adult_caption]}" />
            <c:SettingsRow Label="{Binding S[settings.privacy.policy]}" Kind="Chevron" Icon="{StaticResource Icon.Shield}"
                           Command="{Binding PolicyCommand}" Caption="https://anarqz.github.io/mkwmp/#privacy" />
            <c:SectionHeader Text="{Binding S[settings.privacy.account]}" />
            <c:SettingsRow Label="{Binding S[settings.privacy.delete]}" Icon="{StaticResource Icon.Trash}" Command="{Binding Profile.DeleteCommand}"
                           Caption="{Binding S[settings.privacy.delete_caption]}" />
          </StackPanel>

          <!-- ═════════ Server ═════════ -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=server'}">
            <c:SectionHeader Text="{Binding S[settings.server]}" />
            <Border Style="{StaticResource Field}">
              <StackPanel>
                <TextBlock Text="{Binding S[settings.server.url]}" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding NotBusy}" InputScope="Url" />
                <TextBlock Text="{Binding S[settings.server.caption]}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <settings:StatusLines DataContext="{Binding ServerLines}" />
            <TextBlock Text="{Binding BusyNote}" Style="{StaticResource Note}" Visibility="{Binding BusyNote, Converter={StaticResource Conv.Visible}}" />
          </StackPanel>

          <!-- ═════════ Appearance ═════════ -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=appearance'}">
            <c:SectionHeader Text="{Binding S[settings.appearance.look]}" />
            <c:SettingsRow Label="{Binding S[settings.theme]}" Kind="Value" Value="{Binding ThemeName}" Command="{Binding ThemeCommand}" />
            <c:SettingsRow Label="{Binding S[settings.fullscreen]}" Kind="Toggle" IsOn="{Binding Fullscreen}"
                           Caption="{Binding S[settings.fullscreen.caption]}" />
            <c:SectionHeader Text="{Binding S[settings.appearance.language]}" />
            <c:SettingsRow Label="{Binding S[settings.language]}" Kind="Chevron" Value="{Binding LanguageName}" Command="{Binding LanguageCommand}"
                           Caption="{Binding LanguageCaption}" />
          </StackPanel>

          <!-- ═════════ Updates ═════════ -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=updates'}">
            <c:SectionHeader Text="{Binding S[settings.updates]}" />
            <c:SettingsRow Label="{Binding S[settings.updates.version]}" Kind="Value" Value="{Binding VersionText}" Focusable="False"
                           Caption="{Binding UpdateStatus}" />
            <c:SettingsRow Label="{Binding UpdateInstallLabel}" Kind="Chevron" Icon="{StaticResource Icon.Download}" Command="{Binding UpdateCommand}"
                           Visibility="{Binding UpdateAvailable, Converter={StaticResource Conv.Visible}}" />
            <c:SettingsRow Label="{Binding S[settings.updates.check]}" Icon="{StaticResource Icon.Refresh}" Command="{Binding CheckUpdateCommand}">
              <c:Spinner Width="40" Height="40" Visibility="{Binding UpdateBusy, Converter={StaticResource Conv.Visible}}" />
            </c:SettingsRow>
            <c:SettingsRow Label="{Binding S[settings.updates.auto]}" Kind="Toggle" IsOn="{Binding AutoUpdate}"
                           Caption="{Binding S[settings.updates.auto_caption]}" />
            <StackPanel Visibility="{Binding UpdateNotes, Converter={StaticResource Conv.Visible}}">
              <c:SectionHeader Text="{Binding S[settings.updates.notes]}" />
              <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <TextBlock Text="{Binding UpdateNotes}" Style="{StaticResource Text.Caption}" FontSize="26" LineHeight="40" />
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- ═════════ Support ═════════ -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=support'}">
            <c:SectionHeader Text="{Binding S[settings.support.bug]}" />
            <c:SettingsRow Label="{Binding S[settings.support.logs]}" Icon="{StaticResource Icon.Download}" Command="{Binding SaveLogsCommand}"
                           Caption="{Binding S[settings.support.logs_caption]}" />
            <c:SettingsRow Label="{Binding S[settings.support.issues]}" Kind="Chevron" Icon="{StaticResource Icon.Flag}" Command="{Binding IssuesCommand}"
                           Caption="https://github.com/anarqz/mkwmp/issues" />
            <c:SectionHeader Text="{Binding S[settings.support.help]}" />
            <c:SettingsRow Label="{Binding S[settings.support.guide]}" Kind="Chevron" Icon="{StaticResource Icon.Info}" Command="{Binding GuideCommand}"
                           Caption="https://anarqz.github.io/mkwmp/" />
            <c:SettingsRow Label="{Binding S[settings.support.repo]}" Kind="Chevron" Icon="{StaticResource Icon.Star}" Value="{Binding StarsText}"
                           Command="{Binding RepoCommand}" Caption="https://github.com/anarqz/mkwmp" />
          </StackPanel>

          <!-- ═════════ About ═════════ -->
          <StackPanel Visibility="{Binding CategoryKey, Converter={StaticResource Conv.Visible}, ConverterParameter='=about'}">
            <Border Style="{StaticResource Card}" Margin="0,38,0,0">
              <StackPanel>
                <TextBlock Text="{Binding Shell.AboutTitle}" Style="{StaticResource Text.Heading}" />
                <TextBlock Text="{Binding S[settings.about.what]}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding Shell.AboutBasedOn, Mode=OneWay}" Style="{StaticResource Text.Caption}" Margin="0,14,0,0"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Text="{Binding S[settings.about.gpl]}" Style="{StaticResource Text.Caption}" Margin="0,14,0,0" />
                <TextBlock Text="{Binding S[settings.about.not_affiliated]}" Style="{StaticResource Text.Caption}" FontSize="22" LineHeight="32" Margin="0,14,0,0" />
              </StackPanel>
            </Border>
            <c:SectionHeader Text="{Binding S[settings.about.links]}" />
            <c:SettingsRow Label="{Binding S[settings.about.based_on]}" Kind="Chevron" Command="{Binding BasedOnCommand}"
                           Caption="https://github.com/anarqz/InfinityHorizon" />
            <c:SettingsRow Label="{Binding S[settings.support.repo]}" Kind="Chevron" Command="{Binding RepoCommand}"
                           Caption="https://github.com/anarqz/mkwmp" />
            <c:SettingsRow Label="{Binding S[settings.privacy.policy]}" Kind="Chevron" Command="{Binding PolicyCommand}" />
          </StackPanel>
        </Grid>
      </c:SmoothScrollViewer>
    </Grid>
  </Grid>
</UserControl>
