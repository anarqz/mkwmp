<UserControl x:Class="Mkwmp.App.Views.Dev.GalleryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             Focusable="False">
  <!-- DataContext: GalleryViewModel. Every control of the design system once, and every icon. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <c:PageHeader Title="Design system" Icon="{StaticResource Icon.Star}">
      <c:PageDots Count="5" Index="2" Accent="{DynamicResource Brush.Accent}" Foreground="{DynamicResource Brush.Text}" />
    </c:PageHeader>

    <c:SmoothScrollViewer Grid.Row="1" Padding="92,0,92,60">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="70" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <c:SectionHeader Text="Buttons" />
          <WrapPanel Margin="0,24,0,0">
            <c:ConsoleButton Kind="Primary" Content="Primary" Margin="0,0,18,18" Command="{Binding ToastCommand}" input:FocusNav.IsDefault="True" />
            <c:ConsoleButton Kind="Outline" Content="Outline" Margin="0,0,18,18" Command="{Binding ConfirmCommand}" />
            <c:ConsoleButton Kind="Secondary" Content="Secondary" Margin="0,0,18,18" Command="{Binding MessageCommand}" />
            <c:ConsoleButton Kind="Outline" Content="With icon" Icon="{StaticResource Icon.Download}" Margin="0,0,18,18"
                             Command="{Binding ProgressCommand}" />
            <c:ConsoleButton Kind="Ghost" Content="Ghost" Margin="0,0,18,18" Command="{Binding ThemeCommand}" />
            <c:ConsoleButton Kind="Primary" Content="Disabled" IsEnabled="False" Margin="0,0,18,18" />
          </WrapPanel>

          <c:SectionHeader Text="Rows" />
          <c:SettingsRow Label="A value" Kind="Value" Value="Automatic" />
          <c:SettingsRow Label="A switch" Kind="Toggle" IsOn="{Binding Toggle}" Caption="A caption sits under the rule and explains the row in one or two lines." />
          <c:SettingsRow Label="Opens something" Kind="Chevron" Value="mkw-recomp" Icon="{StaticResource Icon.Folder}" />
          <c:SettingsRow Label="Disabled" Kind="Value" Value="Off" IsEnabled="False" />
          <c:ConsoleSlider Label="A slider" Value="{Binding Slider}" />

          <c:SectionHeader Text="Entry" />
          <TextBox Text="Gamertag" Margin="0,24,0,0" />
          <c:ConsoleCheck Content="I am 18 or older" IsChecked="{Binding Check}" HorizontalAlignment="Left" Margin="0,14,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <c:ToggleSwitch IsChecked="{Binding Toggle}" Margin="10,0,40,0" />
            <c:Spinner Margin="0,0,40,0" />
            <ProgressBar Width="380" Value="0.4" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <c:SectionHeader Text="People, tiles, dock" />
          <StackPanel Orientation="Horizontal" Margin="0,62,0,0">
            <Button Style="{StaticResource AvatarButton}">
              <c:Avatar DisplayName="Alex" Count="2" />
            </Button>
            <c:Avatar DisplayName="Luna" Presence="Playing" Margin="12,0" />
            <c:Avatar DisplayName="Mateus" Presence="Online" Margin="12,0" />
            <c:Avatar DisplayName="Jonas" Presence="Offline" Margin="12,0" />
            <c:Avatar DisplayName="Drift King" Margin="12,0" Width="120" Height="120" />
            <Border Style="{StaticResource Pill}" Margin="24,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="A pill" Style="{StaticResource Text.Value}" FontSize="24" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="-4,40,0,0">
            <c:Tile Title="Play Online" Subtitle="12 of 32 seats" Badge="NEW" Icon="{StaticResource Icon.Kart}" Seed="#0" Width="300" Height="300" />
            <c:Tile Title="Voice &amp; Camera" Icon="{StaticResource Icon.Headset}" Seed="#1" Progress="0.4" Width="300" Height="300" />
          </StackPanel>
          <Border Style="{StaticResource Dock}" Margin="0,44,0,0" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <c:DockButton Icon="{StaticResource Icon.Kart}" Label="Play" Fill="{DynamicResource Brush.Accent}" Tint="{DynamicResource Brush.OnAccent}" />
              <c:DockButton Icon="{StaticResource Icon.Friends}" Label="Friends" Tint="#FFF08A1A" HasDot="True" />
              <c:DockButton Icon="{StaticResource Icon.Settings}" Label="Settings" />
              <c:DockButton Icon="{StaticResource Icon.Power}" Label="Quit" />
            </StackPanel>
          </Border>

          <c:SectionHeader Text="Icons" Margin="0,84,0,0" />
          <ItemsControl ItemsSource="{Binding Icons}" Focusable="False" Margin="0,20,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="104" Margin="0,0,0,14">
                  <c:Icon Data="{Binding Data}" Filled="{Binding Filled}" Width="52" Height="52" Foreground="{DynamicResource Brush.Text}"
                          HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Small}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </c:SmoothScrollViewer>
  </Grid>
</UserControl>
