<UserControl x:Class="Mkwmp.App.Views.Chat.ChatSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             Focusable="False">
  <!-- DataContext: ChatSheetViewModel. STUB content of a BottomSheet: participant cards, then a
       round button, a pill of round toggles, a round button. The bottom margin leaves the hint bar free. -->
  <StackPanel Margin="0,0,0,196">
    <ItemsControl ItemsSource="{Binding Participants}" Focusable="False" HorizontalAlignment="Center" input:FocusNav.IsGroup="True">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource CardButton}" Padding="6" Margin="8,0" Width="452" Height="260" VerticalContentAlignment="Stretch">
            <Grid>
              <Border CornerRadius="10" Background="{Binding Seed, Converter={StaticResource Conv.Art}}" />
              <c:Avatar DisplayName="{Binding Name}" Width="110" Height="110" />
              <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Height="52" CornerRadius="8" Background="#B3202020"
                      Padding="8,0,16,0">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Mic}" Width="30" Height="30" Foreground="White" Margin="0,0,8,0"
                          Visibility="{Binding Speaking, Converter={StaticResource Conv.Visible}}" />
                  <TextBlock Text="{Binding Name}" Foreground="White" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,34,0,0" input:FocusNav.IsGroup="True">
      <c:DockButton Icon="{StaticResource Icon.Exit}" Label="{Binding S[chat.leave]}" Fill="#FFF0521A" Tint="White"
                    Command="{Binding LeaveCommand}" VerticalAlignment="Center" />
      <Border Style="{StaticResource Dock}" Background="{DynamicResource Brush.Surface}" Margin="46,0" Padding="22,14">
        <StackPanel Orientation="Horizontal">
          <c:DockButton Icon="{Binding CameraIcon, Converter={StaticResource Conv.Icon}}" Label="{Binding S[chat.camera]}"
                        Command="{Binding CameraCommand}" input:FocusNav.IsDefault="True" />
          <c:DockButton Icon="{Binding MicIcon, Converter={StaticResource Conv.Icon}}" Label="{Binding S[chat.mic]}"
                        Tint="{DynamicResource Brush.Accent}" Command="{Binding MicCommand}" />
        </StackPanel>
      </Border>
      <c:DockButton Icon="{StaticResource Icon.Settings}" Label="{Binding S[home.settings]}" Fill="{DynamicResource Brush.Surface}"
                    Command="{Binding SettingsCommand}" VerticalAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
