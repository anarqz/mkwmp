<UserControl x:Class="Mkwmp.App.Views.Chat.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:vm="clr-namespace:Mkwmp.App.ViewModels"
             xmlns:chat="clr-namespace:Mkwmp.App.Views.Chat"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             Focusable="False">
  <!-- DataContext: ChatViewModel. The paged introduction of Party Chat: a picture at the left, the
       heading and text at the right, one wide Next; the last page is the consent (a link, a tick
       box, Next disabled until it is ticked). -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <c:PageHeader Title="{Binding Title}">
      <c:PageDots Count="{x:Static vm:ChatViewModel.StepCount}" Index="{Binding Step}"
                  Accent="{DynamicResource Brush.Accent}" Foreground="{DynamicResource Brush.Text}" />
    </c:PageHeader>

    <!-- the three pages of the introduction -->
    <Grid Grid.Row="1" Margin="72,0" VerticalAlignment="Center" HorizontalAlignment="Center"
          Visibility="{Binding IsIntro, Converter={StaticResource Conv.Visible}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MaxWidth="860" />
      </Grid.ColumnDefinitions>
      <chat:ChatArt VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="70,0,0,0">
        <c:SectionHeader Text="{Binding Heading}" ShowRule="False" Margin="0" />
        <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" FontSize="34" LineHeight="50" Margin="21,6,0,0" />
        <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" FontSize="26" LineHeight="39" Margin="21,14,0,0" />
      </StackPanel>
    </Grid>

    <!-- the consent -->
    <StackPanel Grid.Row="1" MaxWidth="1180" Margin="72,0" VerticalAlignment="Center"
                Visibility="{Binding IsConsent, Converter={StaticResource Conv.Visible}}">
      <TextBlock Text="{Binding S[chat.consent.text]}" Style="{StaticResource Text.Body}" FontSize="33" LineHeight="49" />
      <TextBlock Text="{Binding S[chat.consent.note]}" Style="{StaticResource Text.Caption}" FontSize="26" LineHeight="39" Margin="0,16,0,0" />
      <c:ConsoleButton Kind="Secondary" Width="800" Margin="0,54,0,0" Content="{Binding S[setup.consent.policy]}" Command="{Binding PolicyCommand}" />
      <c:ConsoleCheck HorizontalAlignment="Center" MinWidth="580" Margin="0,12,0,0" Content="{Binding S[chat.consent.check]}"
                      IsChecked="{Binding Understood}" input:FocusNav.IsDefault="True" />
    </StackPanel>

    <c:ConsoleButton Grid.Row="2" Kind="Secondary" Width="650" Height="112" Margin="0,0,0,40" Content="{Binding NextLabel}"
                     Command="{Binding NextCommand}" input:FocusNav.IsDefault="True" />
  </Grid>
</UserControl>
