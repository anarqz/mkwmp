<UserControl x:Class="Mkwmp.App.Views.Chat.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mkwmp.App.Controls"
             xmlns:vm="clr-namespace:Mkwmp.App.ViewModels"
             xmlns:input="clr-namespace:Mkwmp.App.Input"
             Focusable="False">
  <!-- DataContext: ChatViewModel. STUB that shows a paged flow: PageHeader with PageDots, a picture
       at the left, SectionHeader and text at the right, one wide button. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <c:PageHeader Title="{Binding S[chat.intro.title]}">
      <c:PageDots Count="{x:Static vm:ChatViewModel.StepCount}" Index="{Binding Step}"
                  Accent="{DynamicResource Brush.Accent}" Foreground="{DynamicResource Brush.Text}" />
    </c:PageHeader>

    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="560" />
        <ColumnDefinition Width="840" />
      </Grid.ColumnDefinitions>

      <!-- our own picture: players in a speech bubble (shapes and the Avatar control only) -->
      <Grid Width="480" Height="380" HorizontalAlignment="Left">
        <Border Width="330" Height="250" CornerRadius="125" Background="{DynamicResource Brush.Surface}" BorderBrush="#FFF08A1A"
                BorderThickness="5" HorizontalAlignment="Right" VerticalAlignment="Top" />
        <Path Data="M0,0 L46,-34 L52,10 Z" Fill="{DynamicResource Brush.Surface}" Stroke="#FFF08A1A" StrokeThickness="5"
              StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,222,0,0" />
        <c:Avatar DisplayName="Luna" Width="104" Height="104" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,34,176,0" />
        <c:Avatar DisplayName="Kai" Width="104" Height="104" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,34,50,0" />
        <c:Avatar DisplayName="Sofia" Width="104" Height="104" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,124,112,0" />
        <c:Avatar DisplayName="{Binding Shell.Profile.Name}" Width="170" Height="170" HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" />
        <Border Width="84" Height="84" CornerRadius="42" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"
                VerticalAlignment="Bottom" Margin="150,0,0,-6" BorderBrush="{DynamicResource Brush.Background}" BorderThickness="5">
          <c:Icon Data="{StaticResource Icon.Mic}" Width="44" Height="44" Foreground="{DynamicResource Brush.OnAccent}" />
        </Border>
      </Grid>

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <c:SectionHeader Text="{Binding Heading}" ShowRule="False" Margin="0" />
        <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" FontSize="34" LineHeight="50" Margin="20,10,0,0" />
        <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" FontSize="27" LineHeight="40" Margin="20,12,0,0" />
      </StackPanel>
    </Grid>

    <c:ConsoleButton Grid.Row="2" Kind="Secondary" Width="650" Height="116" Margin="0,0,0,46" Content="{Binding NextLabel}"
                     Command="{Binding NextCommand}" input:FocusNav.IsDefault="True" />
  </Grid>
</UserControl>
