diff --git a/runtime/plugin/plugin.c b/runtime/plugin/plugin.c
index 7fd8e9d..58d03a9 100644
--- a/runtime/plugin/plugin.c
+++ b/runtime/plugin/plugin.c
@@ -4,6 +4,7 @@
 #include <stdarg.h>
 #include <stddef.h>
 #include <stdio.h>
