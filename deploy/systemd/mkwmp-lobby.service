# mkwmp lobby (Python reference server until the Rust port: server/mkwmp_server.py).
# Needs /opt/mkwmp/venv (h2, cryptography), the repo's server/ in
# /opt/mkwmp/lobby, the TLS pair the game probe trusts in /opt/mkwmp/keys, and
# /opt/mkwmp/config/lobby.env with PUBLIC_HOST=<public IPv4>. See docs/HOSTING.md.
[Unit]
Description=mkwmp lobby (NPLN + Gamesync + TURN)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/mkwmp/lobby/mkwmp_server.py
ConditionPathExists=/opt/mkwmp/config/lobby.env

[Service]
User=mkwmp
WorkingDirectory=/opt/mkwmp/lobby
EnvironmentFile=/opt/mkwmp/config/lobby.env
ExecStart=/opt/mkwmp/venv/bin/python -E -s mkwmp_server.py --host 0.0.0.0 --public-host ${PUBLIC_HOST} --port 8905 --tls-cert /opt/mkwmp/keys/lobby-cert.pem --tls-key /opt/mkwmp/keys/lobby-key.pem --log /var/log/mkwmp/lobby.log --announce-matches
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LogsDirectory=mkwmp
MemoryMax=384M

[Install]
WantedBy=multi-user.target
