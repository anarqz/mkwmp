# Copy to .env and edit. Read by compose.yaml.

# Required: the IPv4 address players reach this machine at (public IP, or
# its LAN address for a LAN party). The game takes an address, not a name.
MKWMP_PUBLIC_IP=

# Shown to players in the launcher.
MKWMP_NAME=mkwmp

# Players seated at once; the rest queue.
MKWMP_CAPACITY=50

# UDP port of the TURN relay, if 3478 is taken on this machine.
# MKWMP_TURN_PORT=3478

# With HTTPS (`docker compose --profile https up -d`): the domain pointing
# here, and keep the seat API off the network so only Caddy reaches it:
# MKWMP_DOMAIN=mkw.example.com
# MKWMP_SEAT_BIND=127.0.0.1:7000
